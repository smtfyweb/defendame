---
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import CaseWizard from '../components/CaseWizard.astro';
import ChatWidget from '../components/ChatWidget.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;            // <title> completo
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object[];        // dados estruturados (Article, FAQPage, BreadcrumbList...)
  article?: { published?: Date; modified?: Date; section?: string; tags?: string[] };
}
const { title, description, image = SITE.ogDefault, type = 'website', noindex = false, jsonLd = [], article } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
---
<!doctype html>
<html lang="pt-BR" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#0b1719" />
  <meta name="color-scheme" content="light dark" />
  <meta property="og:type" content={type} />
  <meta property="og:locale" content={SITE.locale} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  {article?.published && <meta property="article:published_time" content={article.published.toISOString()} />}
  {article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
  {article?.section && <meta property="article:section" content={article.section} />}
  {article?.tags?.map((t) => <meta property="article:tag" content={t} />)}
  <link rel="sitemap" href="/sitemap-index.xml" />
  {jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  <!-- Tema: escuro por padrão; respeita a escolha salva do visitante (antes da pintura, sem "piscar") -->
  <script is:inline>
    (function(){
      var d = document.documentElement;
      d.classList.add('js');
      var saved = null;
      try { saved = localStorage.getItem('dm-theme'); } catch(e){}
      var theme = (saved === 'light' || saved === 'dark') ? saved : 'dark';
      d.setAttribute('data-theme', theme);

      function applyTheme(t){
        d.setAttribute('data-theme', t);
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', t === 'dark' ? '#0b1719' : '#f6fbfa');
        var txt = document.getElementById('drawerThemeTxt');
        if (txt) txt.textContent = t === 'dark' ? 'Alternar para Modo Claro' : 'Alternar para Modo Escuro';
        var toggleBtn = document.getElementById('themeToggle');
        if (toggleBtn) {
          toggleBtn.setAttribute('aria-label', t === 'dark' ? 'Mudar para tema claro' : 'Mudar para tema escuro');
          toggleBtn.setAttribute('title', t === 'dark' ? 'Mudar para tema claro' : 'Mudar para tema escuro');
        }
      }

      applyTheme(theme);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function(){ applyTheme(d.getAttribute('data-theme') || theme); });
      }

      var lastToggle = 0;
      window.toggleTheme = function(){
        var now = Date.now();
        if (now - lastToggle < 250) return;
        lastToggle = now;
        var cur = d.getAttribute('data-theme') || 'dark';
        var next = cur === 'dark' ? 'light' : 'dark';
        try { localStorage.setItem('dm-theme', next); } catch(e){}
        applyTheme(next);
      };
    })();
  </script>
</head>
<body>
  <Header />
  <slot />
  <Footer />
  <CaseWizard />
  <ChatWidget />
  <CookieBanner />
<script>
  // Animações de todo o site (ver src/scripts/motion.ts)
  import { initMotion } from '../scripts/motion';
  initMotion();
  // Tabelas no celular viram fichas: cada célula recebe o nome da sua coluna
  document.querySelectorAll<HTMLTableElement>('.juri-table, .doc-table').forEach((t) => {
    const heads = [...t.querySelectorAll('thead th')].map((th) => th.textContent?.trim() || '');
    if (!heads.length) return;
    t.classList.add('stack-sm');
    t.querySelectorAll('tbody tr').forEach((tr) => [...tr.children].forEach((td, i) => td.setAttribute('data-label', heads[i] || '')));
  });
</script>
</body>
</html>
