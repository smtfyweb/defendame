---
/** Layout das páginas institucionais (texto longo + índice lateral). */
import BaseLayout from './BaseLayout.astro';
interface Props { title: string; description: string; h1: string; lead: string; atualizado?: string; toc: [string, string][]; jsonLd?: object[] }
const { title, description, h1, lead, atualizado, toc, jsonLd = [] } = Astro.props;
import { b } from '../utils/url';
---
<BaseLayout title={title} description={description} jsonLd={jsonLd}>
<main class="inst">
  <div class="inst-head">
    <nav class="crumb" aria-label="Navegação"><a href={b()}>Início</a><span>›</span><span class="crumb-cur">{h1}</span></nav>
    <h1>{h1}</h1><p>{lead}</p>{atualizado && <span class="inst-upd">Última atualização: {atualizado}</span>}
  </div>
  <div class="inst-wrap">
    <article class="doc"><slot /></article>
    <nav class="scard inst-toc" aria-label="Nesta página"><div class="scard-head">Nesta página</div><div class="scard-body"><ul class="toc-list">{toc.map(([a, t]) => <li><a href={`#${a}`}>{t}</a></li>)}</ul></div></nav>
  </div>
</main>
</BaseLayout>
