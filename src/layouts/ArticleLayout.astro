---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import AdSlot from '../components/article/AdSlot.astro';
import ImageSlot from '../components/article/ImageSlot.astro';
import BoxTrilha from '../components/article/BoxTrilha.astro';
import { SITE, AUTHOR, FORMATOS } from '../data/site';
import { temaPorSlug, GRUPOS, TEMAS, fmt } from '../data/temas';
import type { CollectionEntry } from 'astro:content';

interface Props { entry: CollectionEntry<'artigos'>; headings: { depth: number; slug: string; text: string }[] }
const { entry, headings } = Astro.props;
const d = entry.data;
const tema = temaPorSlug(d.tema)!;
const url = new URL(`/${d.tema}/${d.slug}/`, SITE.url).href;
const md = (s: string) => s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/\*(.+?)\*/g, '<em>$1</em>');
const data = (dt: Date) => dt.toLocaleDateString('pt-BR', { timeZone: 'UTC' });
const toc = headings.filter((h) => h.depth === 2);
const enc = encodeURIComponent;
const analise = d.formato === 'analise';
const autorUrl = new URL(AUTHOR.url, SITE.url).href;
const correlatos = (d.relacionados.length ? d.relacionados : TEMAS.filter((t) => t.grupo === tema.grupo && t.slug !== tema.slug).map((t) => t.slug)).slice(0, 4).map(temaPorSlug).filter(Boolean);

const cleanTitle = (d.titulo || '').replace(/<[^>]*>/g, '');
const pessoa = { '@type': 'Person', name: AUTHOR.name, jobTitle: AUTHOR.jobTitle, image: new URL(AUTHOR.photo, SITE.url).href, url: autorUrl, sameAs: [SITE.substack] };
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org', '@type': analise ? 'OpinionNewsArticle' : 'Article', headline: cleanTitle, description: d.descricao, inLanguage: 'pt-BR',
    mainEntityOfPage: analise ? url : { '@type': 'WebPage', '@id': url, reviewedBy: pessoa }, datePublished: d.publicado.toISOString().slice(0, 10), dateModified: (d.atualizado ?? d.publicado).toISOString().slice(0, 10),
    image: new URL(d.ogImage ?? SITE.ogDefault, SITE.url).href, articleSection: tema.nome, keywords: d.palavrasChave,
    author: analise ? pessoa : { '@type': 'Organization', name: `Redação ${SITE.name}`, url: SITE.url },
    ...(analise ? {} : { contributor: { ...pessoa, roleName: 'Revisão técnica' } }),
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url, logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', SITE.url).href } },
  },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: tema.nome, item: new URL(`/${tema.slug}/`, SITE.url).href },
    { '@type': 'ListItem', position: 3, name: cleanTitle, item: url } ] },
];
if (d.faq.length) jsonLd.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.pergunta, acceptedAnswer: { '@type': 'Answer', text: f.resposta } })) });
---
<BaseLayout title={d.seoTitle ?? `${cleanTitle} — ${SITE.name}`} description={d.descricao} image={d.ogImage} type="article" noindex={d.rascunho}
  jsonLd={jsonLd} article={{ published: d.publicado, modified: d.atualizado, section: tema.nome, tags: d.tags }}>
<main class="post">
  <div class="post-top">
    <nav class="crumb" aria-label="Navegação"><a href="/">Início</a><span>›</span><a href={`/${tema.slug}/`}>{tema.nome}</a><span>›</span><span class="crumb-cur">Artigo</span></nav>
    <div class="post-kicker"><span class={`post-fmt fmt-${d.formato}`}>{FORMATOS[d.formato].rotulo}</span><span class="post-vinheta">{d.vinheta}</span></div>
    <h1 class="post-titulo" set:html={d.tituloHtml || d.titulo} />
    <p class="post-sub" set:html={md(d.linhaFina)} />
    <div class="post-meta">
      {analise ? (
        <><img class="post-meta-av mark" src="/favicon.svg" alt="" width="26" height="26" />
        <span>Redação {SITE.name}</span><span class="dot">·</span>
        <span class="post-meta-rev"><img src={AUTHOR.photo} alt="" width="22" height="22" />Análise técnica: <a href={AUTHOR.url}>{AUTHOR.name}</a></span></>
      ) : (
        <><img class="post-meta-av mark" src="/favicon.svg" alt="" width="26" height="26" />
        <span>Redação {SITE.name}</span><span class="dot">·</span>
        <span class="post-meta-rev"><img src={AUTHOR.photo} alt="" width="22" height="22" />Revisão técnica: <a href={AUTHOR.url}>{AUTHOR.name}</a></span></>
      )}
      <span class="dot">·</span>
      <time datetime={(d.atualizado ?? d.publicado).toISOString()}>{d.atualizado ? `Atualizado em ${data(d.atualizado)}` : data(d.publicado)}</time>
      <span class="dot">·</span><span>{d.leitura} min de leitura</span>
    </div>
    <div class="post-actions">
      <a class="pa wa" href={`https://api.whatsapp.com/send?text=${enc(d.titulo + ' — ' + url)}`} target="_blank" rel="noopener" title="Compartilhar no WhatsApp" aria-label="Compartilhar no WhatsApp"><Icon name="whatsapp" /></a>
      <a class="pa" href={`https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`} target="_blank" rel="noopener" title="Compartilhar no LinkedIn" aria-label="Compartilhar no LinkedIn"><Icon name="linkedin" /></a>
      <a class="pa" href={`https://twitter.com/intent/tweet?text=${enc(d.titulo)}&url=${enc(url)}`} target="_blank" rel="noopener" title="Compartilhar no X" aria-label="Compartilhar no X"><Icon name="x-brand" /></a>
      <button class="pa" id="btnShare" type="button" title="Mais opções de compartilhamento" aria-label="Compartilhar"><Icon name="share" /></button>
      <span class="pa-toast" id="toast" role="status"></span>
      <a class="pa-cta" href="/#verificar" data-open-case data-cat={d.tema}>Avaliar situação <Icon name="arrow-right" size={16} stroke={2.2} /></a>
    </div>
  </div>

  <div class="art-player" id="artPlayer" data-audio-url={d.audioUrl || ''}>
    <div class="art-header">
      <span class="art-label">ouça este conteúdo</span>
      <span class="art-badge">DefendaMe</span>
    </div>
    <div class="art-controls">
      <button class="art-play" id="artPlay" type="button" aria-label="Reproduzir" aria-pressed="false">
        <svg id="icoPlay" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="6,3 20,12 6,21"/></svg>
        <svg id="icoPause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" hidden><rect x="5" y="3" width="4" height="18"/><rect x="15" y="3" width="4" height="18"/></svg>
      </button>
      <div class="art-wave" id="artWave" aria-hidden="true">{Array.from({length:60}).map((_,k)=><span style={`--h:${18+Math.round(Math.abs(Math.sin(k*0.72))*55+Math.random()*22)}%`}></span>)}</div>
      <span class="art-time" id="artTime">0:00</span>
      <button class="art-speed" id="artSpeed" type="button">1×</button>
    </div>
  </div>

  <div class="post-wrap">
    <div class="post-content">
      {d.kpis.length > 0 && (
        <div class="seo-kpis"><div class="juri-kpi-grid" data-motion>{d.kpis.map((k, i) => <div class={`kpi-card${k.destaque ? ' highlight' : ''}`} data-reveal style={`--i:${i}`}><span class="kpi-val" data-count-auto data-delay={i * 350}>{k.valor}</span><span class="kpi-label">{k.rotulo}</span></div>)}</div>
        {d.kpiNota && (
          <p class="kpi-disclaimer">
            <Icon name="chart" size={13} />
            <span><strong>Nota metodológica:</strong> {d.kpiNota}</span>
          </p>
        )}</div>
      )}
      {d.trilha && (
        <BoxTrilha trilha={d.trilha} variant="topo" temaSlug={d.tema} />
      )}
      {toc.length > 2 && (
        <nav class="table-of-contents" aria-label="Índice do artigo">
          <div class="toc-header"><Icon name="list" size={16} stroke={2} /><span>Neste artigo você vai encontrar:</span></div>
          <ol class="toc-list">{toc.map((h, i) => <li><a href={`#${h.slug}`}><span class="toc-num">{String(i + 1).padStart(2, '0')}.</span> {h.text.replace(/^\d+\.\s*/, '')}</a></li>)}</ol>
        </nav>
      )}

      <div class="post-body" id="postBody"><slot /></div>

      {d.trilha && (
        <BoxTrilha trilha={d.trilha} variant="rodape" temaSlug={d.tema} />
      )}

      {d.faq.length > 0 && (
        <section class="post-body" id="faq">
          <h2 id="perguntas-frequentes">Perguntas frequentes</h2>
          <div class="faq-list">{d.faq.map((f, i) => (
            <div class={`faq-item${i === 0 ? ' open' : ''}`}><h3 class="faq-h"><button class="faq-q" type="button">{f.pergunta}<span class="faq-icon"><Icon name="plus" size={12} stroke={2.5} /></span></button></h3><div class="faq-a" set:html={md(f.resposta)} /></div>
          ))}</div>
        </section>
      )}

      {d.tags.length > 0 && <div class="post-tags"><span>Tags:</span>{d.tags.map((t) => <a href={`/${tema.slug}/`}>{t}</a>)}</div>}

      <a class="post-cta" href="/#verificar" data-open-case data-cat={d.tema}>
        <span class="post-cta-ic"><Icon name="doc" stroke={1.9} /></span>
        <span class="post-cta-b">
          <span class="post-cta-l">Orientação Preliminar</span>
          <span class="post-cta-t">Passou por uma situação parecida de {tema.nome.toLowerCase()}?</span>
          <span class="post-cta-s">Faça uma checagem das suas provas e descubra se a demanda reúne os requisitos do Juizado Especial Cível.</span>
        </span>
        <span class="post-cta-go">Fazer avaliação <Icon name="arrow-right" size={16} stroke={2.2} /></span>
      </a>

      {d.fontes.length > 0 && (
        <div class="post-fontes" id="fontes">
          <div class="pf-head" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
            <span>{d.fontes.length} fontes normativas consultadas</span>
            <button type="button" class="btn-copy-abnt" id="copyAbnt" data-citation={`${AUTHOR.name.toUpperCase()}. ${d.titulo}. DefendaMe, ${d.publicado.getFullYear()}. Disponível em: <${url}>.`} style="display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:var(--teal);background:var(--surface);border:1px solid var(--line-teal);padding:4px 10px;border-radius:var(--r-btn);cursor:pointer;">
              <Icon name="doc" size={13} stroke={2} />
              <span>Copiar referência ABNT</span>
            </button>
          </div>
          <ul class="normative-list" style="margin-top:14px">{d.fontes.map((f) => <li><strong>{f.nome}{f.descricao ? ':' : ''}</strong> {f.descricao}{f.url && <> (<a href={f.url} target="_blank" rel="noopener noreferrer">acessar fonte oficial</a>)</>}</li>)}</ul>
          <details class="pf-nota"><summary>Nota editorial — caráter informativo</summary>
            <div>Este artigo tem caráter exclusivamente informativo e educativo, nos termos do Provimento CFOAB nº 205/2021 e do Código de Ética e Disciplina da OAB. Não constitui aconselhamento jurídico nem promessa de resultado: os percentuais apresentados refletem tendências estatísticas de decisões já proferidas e não garantem o desfecho de casos individuais, que dependem das provas e das circunstâncias concretas.
              {analise ? ' As análises assinadas expressam a leitura técnica do autor sobre os dados.' : ` Guia produzido pela Redação ${SITE.name} e revisado tecnicamente por ${AUTHOR.name}.`}
              {' '}Os casos ilustrativos são extraídos de decisões públicas do TJSP, com nomes e detalhes alterados para proteger as partes; não se referem a clientes.</div>
          </details>
        </div>
      )}

      <div style="margin: 36px 0;">
        <AdSlot variant="wide" />
      </div>

      <section class="post-body silo-section" id="demandas-relacionadas">
        <h2>Demandas correlatas no Juizado Especial Cível</h2>
        <div class="silo-grid">{correlatos.map((t) => <a href={`/${t!.slug}/`} class="silo-card"><span class="silo-tag">{GRUPOS[t!.grupo]}</span><h4>{t!.nome}</h4><p>{t!.linha} · {fmt(t!.decisoes)} decisões analisadas.</p></a>)}</div>
      </section>
    </div>

    <aside class="post-side">
      <div class="aut" id="autor"><span class="aut-k">{analise ? 'Pesquisa e Análise Técnica' : 'Revisão Técnica de Dados'}</span>
        <div class="aut-top"><img src={AUTHOR.photo} alt={AUTHOR.name} width="64" height="64" /><div><a class="aut-n" href={AUTHOR.url}>{AUTHOR.name}</a><span class="aut-c">{AUTHOR.role}</span></div></div>
        <div class="aut-links"><a class="aut-sub" href={AUTHOR.url}><Icon name="user" size={15} stroke={2} />Perfil e metodologia</a></div></div>
      {d.dadosComarca && (
        <div class="scard"><div class="scard-head">{d.dadosComarca.titulo}<small>{d.dadosComarca.subtitulo}</small></div>
          <div class="scard-body" data-motion>{d.dadosComarca.linhas.map((l, i) => <div class="juri-row" data-reveal style={`--i:${i}`}><span class="juri-label">{l.rotulo}</span><span class={`juri-val${l.tom === 'bom' ? ' good' : l.tom === 'alerta' ? ' warn' : ''}`} data-count-auto data-delay={150 + i * 120}>{l.valor}</span></div>)}</div></div>
      )}
      <ImageSlot
        variant="side"
        tag="Radar Jurimétrico"
        titulo={`Decisões TJSP · ${tema.nome}`}
        legenda={`Distribuição amostral de sentenças e jurisprudência consolidada em ${tema.nome.toLowerCase()}.`}
        dimensao="280 × 200 px"
        icone={tema.icone || 'chart'}
      />
      <AdSlot variant="side" />
      <a class="side-cta" href="/#verificar" data-open-case data-cat={d.tema}><span class="side-cta-l">Diagnóstico de Provas</span><span class="side-cta-t">Seu caso reúne os documentos indispensáveis para o JEC?</span></a>
    </aside>
  </div>
</main>
</BaseLayout>

<script>
  // share nativo
  document.getElementById('btnShare')?.addEventListener('click', async () => {
    const url = location.href;
    const title = document.title;
    if (navigator.share) {
      try { await navigator.share({ title, url }); } catch {}
    } else {
      await navigator.clipboard.writeText(url).catch(() => {});
      const toast = document.getElementById('toast');
      if (toast) { toast.textContent = 'Link copiado!'; setTimeout(() => { toast.textContent = ''; }, 2500); }
    }
  });
  // tamanho da fonte (persistido; botões removidos mas classe mantida para compatibilidade)
  const S = ['txt-sm', 'txt-md', 'txt-lg', 'txt-xl'];
  let i = 1;
  try { i = parseInt(localStorage.getItem('dm-font') || '1', 10); if (!(i >= 0 && i < S.length)) i = 1; } catch {}
  const setF = (n: number) => { document.querySelectorAll('.post-body').forEach((b) => { b.classList.remove(...S); b.classList.add(S[n]); }); i = n; try { localStorage.setItem('dm-font', String(n)); } catch {} };
  setF(i);
  // copiar link
  const toast = document.getElementById('toast')!; let tt: number;
  const say = (m: string) => { toast.textContent = m; toast.classList.add('on'); clearTimeout(tt); tt = window.setTimeout(() => toast.classList.remove('on'), 2200); };
  document.getElementById('copyLink')?.addEventListener('click', (e) => {
    const u = (e.currentTarget as HTMLElement).dataset.url!;
    navigator.clipboard?.writeText(u).then(() => say('Link copiado'), () => say(u)) ?? say(u);
  });
  // copiar referência ABNT
  document.getElementById('copyAbnt')?.addEventListener('click', (e) => {
    const cit = (e.currentTarget as HTMLElement).dataset.citation!;
    navigator.clipboard?.writeText(cit).then(() => say('Referência ABNT copiada!'), () => say(cit)) ?? say(cit);
  });
  // player de áudio
  (function(){
    const player = document.getElementById('artPlayer') as HTMLElement;
    const btn = document.getElementById('artPlay') as HTMLButtonElement;
    const icoPlay = document.getElementById('icoPlay') as SVGElement;
    const icoPause = document.getElementById('icoPause') as SVGElement;
    const timeEl = document.getElementById('artTime') as HTMLElement;
    const speedBtn = document.getElementById('artSpeed') as HTMLButtonElement;
    const audioUrl = player?.dataset.audioUrl || '';
    const speeds = [1, 1.5, 2]; let si = 0;
    const fmt = (s: number) => `${Math.floor(s/60)}:${String(Math.floor(s%60)).padStart(2,'0')}`;
    let ticker: number;
    const setPlaying = (on: boolean) => {
      btn.setAttribute('aria-pressed', String(on));
      icoPlay.hidden = on; icoPause.hidden = !on;
      player.classList.toggle('playing', on);
    };

    if (audioUrl) {
      const audio = new Audio(audioUrl);
      audio.addEventListener('timeupdate', () => { timeEl.textContent = fmt(audio.currentTime); });
      audio.addEventListener('ended', () => setPlaying(false));
      speedBtn.addEventListener('click', () => { si = (si+1)%speeds.length; audio.playbackRate = speeds[si]; speedBtn.textContent = speeds[si]+'×'; });
      btn.addEventListener('click', () => {
        if (audio.paused) { audio.play(); setPlaying(true); }
        else { audio.pause(); setPlaying(false); }
      });
      addEventListener('beforeunload', () => audio.pause());
    } else {
      const synth = window.speechSynthesis;
      if (!synth || !('SpeechSynthesisUtterance' in window)) { btn.disabled = true; return; }
      let elapsed = 0;
      // Pré-carrega vozes (Chrome/mobile não carrega de imediato)
      let voices: SpeechSynthesisVoice[] = [];
      const loadVoices = () => { voices = synth.getVoices(); };
      loadVoices();
      synth.onvoiceschanged = loadVoices;
      speedBtn.addEventListener('click', () => { si = (si+1)%speeds.length; speedBtn.textContent = speeds[si]+'×'; });
      btn.addEventListener('click', () => {
        if (synth.speaking || synth.pending) {
          synth.cancel(); clearInterval(ticker); setPlaying(false); elapsed = 0; timeEl.textContent = '0:00'; return;
        }
        const titulo = document.querySelector('.post-titulo')?.textContent?.trim() || '';
        const corpo = [...(document.getElementById('postBody')?.querySelectorAll('h2,h3,p,li') || [])].map(n => n.textContent?.trim()).filter(Boolean).join('. ');
        const txt = (titulo ? titulo + '. ' : '') + corpo;
        if (!txt.trim()) return;
        const u = new SpeechSynthesisUtterance(txt); u.lang = 'pt-BR'; u.rate = speeds[si];
        // Recarrega vozes no click (podem ter chegado depois do load)
        const lv = synth.getVoices();
        const v = lv.find(v => /pt-BR|pt_BR/i.test(v.lang)) || lv.find(v => /pt/i.test(v.lang));
        if (v) u.voice = v;
        u.onend = u.onerror = () => { clearInterval(ticker); setPlaying(false); elapsed = 0; timeEl.textContent = '0:00'; };
        // Chrome: se paused (bug conhecido), resume antes de speak
        if (synth.paused) synth.resume();
        synth.speak(u); setPlaying(true);
        elapsed = 0; clearInterval(ticker);
        ticker = window.setInterval(() => {
          // Chrome 15s bug keep-alive
          if (synth.speaking && !synth.paused) { synth.pause(); synth.resume(); }
          elapsed++; timeEl.textContent = fmt(elapsed);
        }, 1000);
      });
      addEventListener('beforeunload', () => { synth.cancel(); clearInterval(ticker); });
    }
  })();
  // FAQ
  document.querySelectorAll('.faq-q').forEach((b) => b.addEventListener('click', () => {
    const it = b.closest('.faq-item')!, was = it.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach((x) => x.classList.remove('open'));
    if (!was) it.classList.add('open');
  }));
</script>
