---
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/Icon.astro';
const toc: [string, string][] = [
  ['oque', 'O que são cookies'],
  ['tipos', 'Quais usamos'],
  ['gerenciar', 'Como gerenciar'],
  ['terceiros', 'Cookies de terceiros'],
