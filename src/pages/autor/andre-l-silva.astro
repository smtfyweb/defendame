---
import PageLayout from '../../layouts/PageLayout.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';
import { SITE, AUTHOR, DATASET, FORMATOS } from '../../data/site';
import { temaPorSlug } from '../../data/temas';

const todos = (await getCollection('artigos', (a) => !a.data.rascunho)).sort((a, b) => +b.data.publicado - +a.data.publicado);
const analises = todos.filter((a) => a.data.formato === 'analise');
const guias = todos.filter((a) => a.data.formato === 'guia');
const data = (dt: Date) => dt.toLocaleDateString('pt-BR', { timeZone: 'UTC', day: '2-digit', month: 'short', year: 'numeric' });
const url = new URL(AUTHOR.url, SITE.url).href;

const toc: [string, string][] = [
  ['posicionamento', 'Posicionamento e Princípio de Atuação'],
  ['perspectivas', 'Quatro Perspectivas Integradas'],
  ['atuacao', 'Legal Analytics e Análise Probatória'],
  ['formacao', 'Formação Acadêmica e Multidisciplinar'],
  ['modalidades', 'Modalidades Editoriais e Tom de Voz'],
  ['etica', 'Compromisso Ético e CFOAB nº 205/2021'],
  ...(analises.length ? [['analises', 'Análises Técnicas Assinadas'] as [string, string]] : []),
  ...(guias.length ? [['guias', 'Guias Técnicos Revisados'] as [string, string]] : []),
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    url,
    mainEntity: {
      '@type': 'Person',
      '@id': `${url}#person`,
      name: AUTHOR.name,
      jobTitle: AUTHOR.jobTitle,
      image: new URL(AUTHOR.photo, SITE.url).href,
      url,
      worksFor: { '@type': 'Organization', name: SITE.name, url: SITE.url },
      alumniOf: AUTHOR.alumniOf.map((n) => ({ '@type': 'CollegeOrUniversity', name: n })),
      knowsAbout: [
        'Jurimetria',
        'Legal Analytics',
        'Juizados Especiais Cíveis',
        'Direito do Consumidor',
        'Decisões Judiciais do TJSP',
        'Responsabilidade Civil no Transporte Aéreo',
        'Fraudes Bancárias e Golpe do Pix',
        'Negativação Indevida e Dano Moral'
      ]
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: AUTHOR.name, item: url }
    ]
  }
];
---

<PageLayout
  title={`${AUTHOR.name} — ${AUTHOR.role} | ${SITE.name}`}
  description={`${AUTHOR.name}, ${AUTHOR.jobTitle}. Pesquisa jurídica orientada por evidências, análise empírica de decisões judiciais e investigação dos conflitos nas relações de consumo no JEC.`}
  h1="André L. <em>Silva</em>"
  lead="Pesquisador jurídico | Jurimetria e Legal Analytics. Investigação empírica de decisões judiciais, análise probatória e comportamento decisório no Juizado Especial Cível paulista."
  toc={toc}
  jsonLd={jsonLd}
>

<div class="autor-hero" data-motion data-reveal>
  <img src={AUTHOR.photo} alt={AUTHOR.name} width="112" height="112" />
  <div>
    <b>{AUTHOR.name}</b>
    <span class="ah-r">{AUTHOR.role}</span>
    <p style="margin: 6px 0 16px; font-size: 14.5px; color: var(--fg-mid); line-height: 1.55;">
      Responsável pela estruturação das pesquisas e análises jurimétricas do DefendaMe. Reúne formação jurídica, conhecimentos em ciência de dados e vivência em ambientes corporativos para investigar o comportamento decisório do Tribunal de Justiça de São Paulo nas controvérsias de consumo.
    </p>
    <div class="aut-links">
      <a class="aut-sub" href="#perspectivas"><Icon name="shield" size={15} stroke={2} />4 Perspectivas Integradas</a>
      <a class="aut-sub" href="#atuacao"><Icon name="chart" size={15} stroke={2} />Legal Analytics</a>
      <a class="aut-sub" href="#formacao"><Icon name="doc" size={15} stroke={2} />Formação Acadêmica</a>
    </div>
  </div>
</div>

<div class="big-stats" data-motion>
  <div data-reveal style="--i:0">
    <b data-count-auto data-delay="0">{DATASET.totalFmt}</b>
    <span>Decisões públicas do TJSP catalogadas</span>
  </div>
  <div data-reveal style="--i:1">
    <b data-count-auto data-delay="350">10 RAJs</b>
    <span>Regiões Administrativas Judiciárias analisadas</span>
  </div>
  <div data-reveal style="--i:2">
    <b data-count-auto data-delay="700">14 Silos</b>
    <span>Demandas críticas estruturadas no JEC</span>
  </div>
</div>

<h2 id="posicionamento">Posicionamento e Princípio de Atuação</h2>
<p>
  O trabalho de André L. Silva é orientado pela <strong>pesquisa jurídica empírica fundamentada em evidências</strong>. Em vez de deduzir soluções apenas de teorias abstratas ou de opiniões isoladas, dedica-se a investigar como os magistrados dos Juizados Especiais Cíveis decidem na prática os conflitos entre consumidores e fornecedores.
</p>
<div class="about-card" style="margin: 20px 0; border-left: 3px solid var(--teal);">
  <div style="display: flex; gap: 14px; align-items: flex-start;">
    <span style="color: var(--teal); margin-top: 2px;"><Icon name="gavel" size={24} stroke={2} /></span>
    <div>
      <h3 style="margin: 0 0 6px; font-size: 16.5px; color: var(--navy);">Princípio de Atuação Forense</h3>
      <p style="margin: 0; font-size: 14.5px; color: var(--fg-mid); line-height: 1.6;">
        <em>"Investigar antes de concluir, apresentar evidências antes de afirmar e reconhecer os limites dos dados antes de interpretar seus resultados."</em>
      </p>
    </div>
  </div>
</div>

<h2 id="perspectivas">Quatro Perspectivas Integradas</h2>
<p>
  A compreensão consistente dos litígios de consumo exige uma abordagem multidisciplinar. A investigação de André integra quatro perspectivas complementares:
</p>

<div class="about-grid" data-motion style="grid-template-columns: repeat(2, minmax(0,1fr)); gap: 16px; margin: 20px 0;">
  <div class="about-card" data-reveal style="--i:0">
    <span class="med-icon"><Icon name="bank" size={22} stroke={2} /></span>
    <h3>1. Perspectiva Corporativa</h3>
    <p>A experiência executiva e comercial permite compreender a estrutura real das grandes empresas: fluxos de atendimento ao cliente, canais de SAC e ouvidoria, rotinas automatizadas de cobrança e os pontos de atrito que geram os litígios de massa.</p>
  </div>

  <div class="about-card" data-reveal style="--i:1">
    <span class="med-icon"><Icon name="shield" size={22} stroke={2} /></span>
    <h3>2. Perspectiva Jurídica</h3>
    <p>A formação em Direito fundamenta o exame dos critérios de responsabilidade civil objetiva, a teoria do risco da atividade, os deveres de informação e segurança do CDC e a dinâmica processual dos Juizados Especiais Cíveis [Lei nº 9.099/1995].</p>
  </div>

  <div class="about-card" data-reveal style="--i:2">
    <span class="med-icon"><Icon name="search" size={22} stroke={2} /></span>
    <h3>3. Perspectiva Investigativa</h3>
    <p>A pesquisa documental minuciosa em acórdãos e sentenças permite isolar os fundamentos determinantes, comparar teses das partes, confrontar divergências entre juizados e identificar o que realmente convence o magistrado.</p>
  </div>

  <div class="about-card" data-reveal style="--i:3">
    <span class="med-icon"><Icon name="chart" size={22} stroke={2} /></span>
    <h3>4. Perspectiva Analítica</h3>
    <p>A jurimetria e o Legal Analytics transformam grandes volumes de decisões em indicadores objetivos de desfecho, dosimetria e tempo médio, com estrito respeito aos limites estatísticos e metodológicos da amostra.</p>
  </div>
</div>

<h2 id="atuacao">Legal Analytics e Análise Probatória</h2>
<p>
  No DefendaMe, André dedica-se à mineração e organização de dados judiciais para responder às dúvidas reais do cidadão: o que aconteceu em processos semelhantes e quais provas foram determinantes para o resultado.
</p>
<ul style="margin: 16px 0 20px; line-height: 1.7;">
  <li><strong>Padrões de fundamentação:</strong> mapeamento dos argumentos acolhidos e rejeitados pelos magistrados paulistas em cada espécie de falha de serviço;</li>
  <li><strong>Dossiê probatório essencial:</strong> identificação dos documentos que integraram as demandas exitosas e das falhas documentais que motivaram a improcedência do pedido;</li>
  <li><strong>Faixas reais de indenização:</strong> quantificação estatística de valores arbitrados a título de danos morais e materiais, afastando expectativas irreais;</li>
  <li><strong>Duração média dos processos:</strong> monitoramento do intervalo médio entre a distribuição da petição inicial e a prolação da sentença no primeiro grau do JEC.</li>
</ul>

<h2 id="formacao">Formação Acadêmica e Multidisciplinar</h2>
<p>
  A atuação profissional é sustentada por uma trajetória acadêmica contínua que une o Direito, as Ciências Exatas e as Dinâmicas Mercadológicas:
</p>

<div class="bio-timeline">
  <div class="bio-entry">
    <h3 class="bio-title">Bacharelado em Direito</h3>
    <div class="bio-inst">Universidade Paulista [UNIP]</div>
    <p class="bio-desc">
      Formação jurídica orientada ao Direito Privado, Teoria Geral da Responsabilidade Civil, microssistema do Código de Defesa do Consumidor e Direito Processual Civil. Pesquisa direcionada à dinâmica dos Juizados Especiais Cíveis [Lei nº 9.099/1995], critérios de admissibilidade probatória e jurisprudência das Turmas Recursais do TJSP.
    </p>
  </div>

  <div class="bio-entry">
    <h3 class="bio-title">Graduação em Marketing</h3>
    <div class="bio-inst">Universidade de Mogi das Cruzes [UMC]</div>
    <p class="bio-desc">
      Compreensão das dinâmicas comerciais, canais de relacionamento corporativo, comportamento do consumidor e práticas mercadológicas que regem as relações entre fornecedores de grande porte e o consumidor final.
    </p>
  </div>

  <div class="bio-entry">
    <h3 class="bio-title">Formação Complementar em Ciência de Dados, IA e Analytics Aplicado</h3>
    <div class="bio-inst">Pontifícia Universidade Católica do Paraná [PUC-PR]</div>
    <p class="bio-desc">
      Formação analítica aplicada ao processamento de dados judiciais: mineração de dados textuais, processamento de linguagem natural [NLP] aplicado a sentenças e acórdãos, modelagem de indicadores e análise estatística de decisões.
    </p>
  </div>

  <div class="bio-entry">
    <h3 class="bio-title">Pós-Graduações Executivas [Em Andamento]</h3>
    <div class="bio-inst">Escola Paulista de Negócios [EPN]</div>
    <p class="bio-desc">
      Dois programas de MBA atualmente em curso: Gestão Estratégica Mercadológica e MBA Executivo em Direito do Consumidor, Mercados Digitais e Defesa Concorrencial, focados na governança corporativa e no impacto das plataformas digitais sobre as relações de consumo.
    </p>
  </div>
</div>

<h2 id="modalidades">Modalidades Editoriais e Tom de Voz</h2>
<p>
  A comunicação do autor no DefendaMe adota tom <strong>investigativo, analítico, didático, crítico e prudente</strong>. A escrita prioriza o problema fático concreto, confronta decisões divergentes e explicita fontes e limitações metodológicas.
</p>
<p>
  O conteúdo do portal distingue claramente a autoria individual do pesquisador e a comunicação institucional:
</p>
<ul style="margin: 16px 0 20px; line-height: 1.7;">
  <li><strong>Análises Autorais:</strong> artigos assinados por André L. Silva, apresentando investigação empírica de decisões e leitura crítica de precedentes em primeira pessoa moderada;</li>
  <li><strong>Guias Técnicos:</strong> textos elaborados pela Redação DefendaMe, com revisão técnica e metodológica de André L. Silva para garantir a precisão jurisprudencial;</li>
  <li><strong>Estudos Especiais:</strong> pesquisas aprofundadas conduzidas em colaboração com a equipe técnica da plataforma.</li>
</ul>

<h2 id="etica">Compromisso Ético e CFOAB nº 205/2021</h2>
<div class="alert-box-info" style="margin: 20px 0;">
  <div class="alert-header">
    <Icon name="shield" size={20} stroke={2} />
    <strong>Alinhamento Ético e Normativo</strong>
  </div>
  <p style="margin-bottom: 10px;">
    Todas as análises e conteúdos assinados ou revisados por André L. Silva possuem finalidade exclusivamente pedagógica, analítica e informativa, em integral obediência ao Provimento CFOAB nº 205 de 2021 e ao Código de Ética e Disciplina da OAB.
  </p>
  <p style="margin-bottom: 10px;">
    <strong>Sem promessa de resultado:</strong> A jurimetria identifica tendências estatísticas em decisões passadas do Tribunal de Justiça de São Paulo; não assegura o resultado de processos individuais, cuja análise cabe com exclusividade ao juiz natural da causa com base no conjunto probatório.
  </p>
  <p style="margin: 0;">
    <strong>Assistência jurídica:</strong> Embora a Lei nº 9.099 de 1995 autorize ajuizamento sem advogado em causas de até 20 salários mínimos, o patrocínio técnico por profissional regularmente inscrito na OAB ou membro da Defensoria Pública é determinante para restabelecer a paridade de armas contra grandes bancas corporativas e privativo na fase recursal perante o Colégio Recursal.
  </p>
</div>

{analises.length > 0 && <>
<h2 id="analises">Análises Técnicas Assinadas</h2>
<p style="color: var(--fg-muted); margin-bottom: 16px;">
  Estudos jurimétricos assinados com leitura analítica e empírica dos dados judiciais.
</p>
<ul class="autor-list" data-motion>{analises.map((a) => <li><a href={`/${a.data.tema}/${a.data.slug}/`}><span class="al-k"><span class="post-fmt fmt-analise">{FORMATOS.analise.rotulo}</span>{temaPorSlug(a.data.tema)?.nome} · {data(a.data.publicado)}</span><span class="al-t">{a.data.titulo}</span><span class="al-d">{a.data.descricao}</span></a></li>)}</ul>
</>}

{guias.length > 0 && <>
<h2 id="guias">Guias Técnicos Revisados</h2>
<p style="color: var(--fg-muted); margin-bottom: 16px;">
  Textos de orientação prática produzidos pela Redação DefendaMe com validação metodológica de precedentes.
</p>
<ul class="autor-list" data-motion>{guias.map((a) => <li><a href={`/${a.data.tema}/${a.data.slug}/`}><span class="al-k"><span class="post-fmt fmt-guia">{FORMATOS.guia.rotulo}</span>{temaPorSlug(a.data.tema)?.nome} · {data(a.data.publicado)}</span><span class="al-t">{a.data.titulo}</span><span class="al-d">{a.data.descricao}</span></a></li>)}</ul>
</>}

<p style="margin-top: 36px;"><a class="btn btn-primary" href="/#verificar" data-open-case>Verificar meu caso no Juizado <Icon name="arrow-right" size={16} stroke={2.2} /></a></p>

</PageLayout>

<style>
  .bio-timeline {
    display: flex;
    flex-direction: column;
    margin: 20px 0 28px;
    border-top: 1px solid var(--border);
  }
  .bio-entry {
    padding: 20px 0 22px;
    border-bottom: 1px solid var(--border);
  }
  .bio-title {
    margin: 0 0 4px;
    font-size: 17.5px;
    font-weight: 600;
    color: var(--navy);
  }
  .bio-inst {
    font-size: 14px;
    font-weight: 500;
    color: var(--fg-muted);
    margin-bottom: 10px;
  }
  .bio-desc {
    margin: 0;
    font-size: 14.5px;
    color: var(--fg-mid);
    line-height: 1.65;
  }
</style>
