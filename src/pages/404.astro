---
import BaseLayout from '../layouts/BaseLayout.astro';
import { b } from '../utils/url';
---
<BaseLayout title="Página não encontrada — DefendaMe" description="A página procurada não existe." noindex>
<main class="inst"><div class="inst-head"><h1>Página não encontrada</h1><p>O endereço pode ter mudado. Volte para a <a href={b()} style="color:var(--teal)">página inicial</a> ou veja <a href={b('artigos/')} style="color:var(--teal)">todos os artigos</a>.</p></div></main>
</BaseLayout>
