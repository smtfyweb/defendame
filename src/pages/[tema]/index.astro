---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import AdSlot from '../../components/article/AdSlot.astro';
import ImageSlot from '../../components/article/ImageSlot.astro';
import { TEMAS, GRUPOS, fmt, getSecaoCorrelatos, type Tema } from '../../data/temas';
import { getTemaDetalhamento } from '../../data/temasDetalhamento';
import { SITE, DATASET } from '../../data/site';

export function getStaticPaths() { return TEMAS.map((t) => ({ params: { tema: t.slug }, props: { tema: t } })); }
const { tema } = Astro.props as { tema: Tema };
const artigos = (await getCollection('artigos', ({ data }) => data.tema === tema.slug && (import.meta.env.DEV || !data.rascunho)))
  .sort((a, b) => {
    if (a.data.trilha && b.data.trilha && a.data.trilha.slug === b.data.trilha.slug) {
      return a.data.trilha.episodio - b.data.trilha.episodio;
    }
    return +b.data.publicado - +a.data.publicado;
  });

const detalhe = getTemaDetalhamento(tema.slug);
const secao = getSecaoCorrelatos(tema.slug);
const topOutro = secao.top;
const sideOutros = secao.side;
const maisOutros = secao.maisDoGrupo;
const tituloSecao = secao.titulo;
const subtituloSecao = secao.subtitulo;
const slotsH = secao.slotsH;

const data = (d: Date) => d.toLocaleDateString('pt-BR', { timeZone: 'UTC' });
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: `${tema.nome} no Juizado Especial Cível`, url: new URL(`/${tema.slug}/`, SITE.url).href,
  breadcrumb: { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Início', item: SITE.url }, { '@type': 'ListItem', position: 2, name: tema.nome }] } }];
---
<BaseLayout title={`${tema.nome} no JEC: direitos, decisões e guias — ${SITE.name}`} description={`${tema.linha}. Artigos e dados de ${fmt(tema.decisoes)} decisões do TJSP sobre ${tema.nome.toLowerCase()} no Juizado Especial Cível.`} jsonLd={jsonLd}>
<main class="inst">
  <div class="inst-head">
    <nav class="crumb" aria-label="Navegação"><a href="/">Início</a><span>›</span><a href="/#temas">Temas</a><span>›</span><span class="crumb-cur">{tema.nome}</span></nav>
    <span class="post-vinheta">{GRUPOS[tema.grupo]}</span>
    <h1>{tema.nome}</h1>
    <p>{tema.linha}. Entenda seus direitos, descubra o que separa quem ganha de quem perde e veja como o TJSP tem decidido.</p>
  </div>
  {detalhe ? (
    <div class="jurimetria-dash">
      <div style="background:var(--muted-bg);padding:14px;border-radius:var(--r-lg);margin-bottom:14px;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;padding:2px 4px;">
          <span style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--fg-muted);">Distribuição de Decisões no TJSP (10 RAJs)</span>
          <span style="font-size:12.5px;color:var(--fg-muted);font-weight:600;">{fmt(detalhe.jurimetria.total)} sentenças analisadas</span>
        </div>
        <div class="stats-jurimetria-grid">
          <div style="background:var(--surface);border-radius:var(--r);padding:14px 16px;border-top:3px solid var(--teal);">
            <b style="display:block;font-size:26px;font-weight:700;color:var(--teal);line-height:1.1;">{detalhe.jurimetria.procedenteTotalPct.toFixed(1).replace('.', ',')}%</b>
            <span style="font-size:12.5px;color:var(--fg-mid);font-weight:600;display:block;margin-top:4px;">Procedente Total</span>
            <span style="font-size:11.5px;color:var(--fg-muted);line-height:1.3;display:block;">Acolhimento integral</span>
          </div>
          <div style="background:var(--surface);border-radius:var(--r);padding:14px 16px;border-top:3px solid #d97706;">
            <b style="display:block;font-size:26px;font-weight:700;color:#d97706;line-height:1.1;">{detalhe.jurimetria.parcialPct.toFixed(1).replace('.', ',')}%</b>
            <span style="font-size:12.5px;color:var(--fg-mid);font-weight:600;display:block;margin-top:4px;">Parcialmente Proc.</span>
            <span style="font-size:11.5px;color:var(--fg-muted);line-height:1.3;display:block;">Dano moral reduzido</span>
          </div>
          <div style="background:var(--surface);border-radius:var(--r);padding:14px 16px;border-top:3px solid #2563eb;">
            <b style="display:block;font-size:26px;font-weight:700;color:#2563eb;line-height:1.1;">{detalhe.jurimetria.acordosPct.toFixed(1).replace('.', ',')}%</b>
            <span style="font-size:12.5px;color:var(--fg-mid);font-weight:600;display:block;margin-top:4px;">Acordos Homologados</span>
            <span style="font-size:11.5px;color:var(--fg-muted);line-height:1.3;display:block;">Conciliação prévia</span>
          </div>
          <div style="background:var(--surface);border-radius:var(--r);padding:14px 16px;border-top:3px solid #dc2626;">
            <b style="display:block;font-size:26px;font-weight:700;color:#dc2626;line-height:1.1;">{detalhe.jurimetria.improcedentePct.toFixed(1).replace('.', ',')}%</b>
            <span style="font-size:12.5px;color:var(--fg-mid);font-weight:600;display:block;margin-top:4px;">Improcedente</span>
            <span style="font-size:11.5px;color:var(--fg-muted);line-height:1.3;display:block;">Falta de provas</span>
          </div>
        </div>

        <div style="margin-top:10px;background:var(--surface);border-radius:var(--r);padding:12px 16px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
          <div style="display:flex;align-items:center;gap:8px;">
            <span style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:var(--r-btn);background:var(--teal-pale);color:var(--teal);"><Icon name="gavel" size={16} /></span>
            <span style="font-size:13px;color:var(--fg-mid);"><strong>Faixa típica de indenização no TJSP:</strong> <span style="color:var(--navy);font-weight:700;">{detalhe.jurimetria.faixaDanoMoral}</span></span>
          </div>
          <span style="font-size:12px;color:var(--fg-muted);">Valores médios para cancelamento sem assistência ou atraso &gt; 4h</span>
        </div>
      </div>

      <div style="background:var(--surface);border:1px solid var(--border);border-left:4px solid var(--teal);border-radius:var(--r);padding:22px 24px;box-shadow:var(--shadow);">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
          <span style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:var(--r-btn);background:var(--teal-pale);color:var(--teal);"><Icon name="chart" size={16} /></span>
          <h3 style="font-size:17.5px;font-weight:700;color:var(--navy);margin:0;">O que os números revelam sobre as decisões de {tema.nome.toLowerCase()}?</h3>
        </div>
        <p style="font-size:14.5px;line-height:1.65;color:var(--fg-mid);margin:0 0 10px;">
          {detalhe.jurimetria.comentario}
        </p>
        <div style="font-size:13px;color:var(--teal);font-weight:600;">
          ↳ Veja a lista de documentos abaixo que evita a procedência parcial ou a improcedência do seu pedido.
        </div>
      </div>

      <div class="regras-jec-grid" style="margin-top:14px;background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:16px 20px;">
        <div>
          <span style="display:flex;align-items:center;gap:6px;font-size:12px;font-weight:700;color:var(--navy);text-transform:uppercase;letter-spacing:.04em;margin-bottom:4px;">
            <Icon name="pin" size={14} /> Onde Ajuizar (Foro)
          </span>
          <span style="font-size:13px;color:var(--fg-mid);line-height:1.45;display:block;">{detalhe.regrasJec.foro}</span>
        </div>
        <div>
          <span style="display:flex;align-items:center;gap:6px;font-size:12px;font-weight:700;color:var(--navy);text-transform:uppercase;letter-spacing:.04em;margin-bottom:4px;">
            <Icon name="shield" size={14} /> Tentativa Prévia
          </span>
          <span style="font-size:13px;color:var(--fg-mid);line-height:1.45;display:block;">{detalhe.regrasJec.orgaoPrevio}</span>
        </div>
        <div>
          <span style="display:flex;align-items:center;gap:6px;font-size:12px;font-weight:700;color:var(--navy);text-transform:uppercase;letter-spacing:.04em;margin-bottom:4px;">
            <Icon name="user" size={14} /> Assistência Jurídica
          </span>
          <span style="font-size:13px;color:var(--fg-mid);line-height:1.45;display:block;">{detalhe.regrasJec.jusPostulandi}</span>
        </div>
      </div>
    </div>
  ) : (
    <div class="big-stats" style="max-width:820px">
      <div><b>{tema.procedenciaPct.toFixed(1).replace('.', ',')}%</b><span>tiveram pedidos acolhidos</span></div>
      <div><b style="color:#c53030">{(100 - tema.procedenciaPct).toFixed(1).replace('.', ',')}%</b><span>tiveram pedidos rejeitados</span></div>
      <div><b>{fmt(tema.decisoes)}</b><span>decisões no TJSP (10 RAJs)</span></div>
    </div>

    <div style="max-width:820px;margin:24px auto 36px;background:var(--surface);border:1px solid var(--border);border-left:4px solid var(--teal);border-radius:var(--r);padding:22px 24px;">
      <h3 style="font-size:17.5px;font-weight:600;color:var(--navy);margin:0 0 8px;">O que separa quem ganha de quem perde em {tema.nome.toLowerCase()}?</h3>
      <p style="font-size:15px;line-height:1.65;color:var(--fg-mid);margin:0;">
        A análise de <strong>{fmt(tema.decisoes)} decisões judiciais</strong> em todo o Estado de São Paulo mostra que a diferença entre os <strong>{tema.procedenciaPct.toFixed(1).replace('.', ',')}%</strong> vitoriosos e os <strong>{(100 - tema.procedenciaPct).toFixed(1).replace('.', ',')}%</strong> que perderam está na consistência das <strong style="color:var(--navy)">provas pré-constituídas</strong> (tentativa administrativa registrada via protocolo SAC/Consumidor.gov, extratos com data e hora e comprovação imediata da falha do serviço).
      </p>
    </div>
  )}

  <div class="inst-wrap">
    <div class="doc">
      {detalhe && detalhe.provasIndispensaveis.length > 0 && (
        <section class="provas-indispensaveis" style="margin-bottom:40px;">
          <div style="display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--teal);background:var(--teal-pale);padding:5px 12px;border-radius:var(--r-btn);margin-bottom:12px;border:1px solid var(--line-teal);">
            <Icon name="shield" size={14} /> Curadoria Probatória DefendaMe
          </div>
          <h2 style="font-size:24px;font-weight:700;color:var(--navy);margin:0 0 10px;line-height:1.3;">
            Documentos indispensáveis: o que não pode faltar na sua ação
          </h2>
          <p style="font-size:15px;line-height:1.65;color:var(--fg-mid);margin:0 0 20px;">
            Com base em nossa pesquisa contínua e no acompanhamento de milhares de decisões do JEC paulista, identificamos que a maioria dos pedidos rejeitados decorre da falta de documentos básicos no momento da inicial. Reunimos aqui os elementos de prova que você deve organizar antes de procurar o Juizado ou um Advogado:
          </p>

          <div class="provas-list" style="display:flex;flex-direction:column;gap:12px;">
            {detalhe.provasIndispensaveis.map((p, idx) => (
              <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:18px 20px;display:flex;align-items:flex-start;gap:16px;box-shadow:var(--shadow);">
                <span style="display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:var(--r-btn);background:var(--teal-pale);color:var(--teal);flex-shrink:0;">
                  <Icon name={p.icone} size={20} />
                </span>
                <div style="flex:1;min-width:0;">
                  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-bottom:4px;">
                    <strong style="font-size:15.5px;color:var(--navy);">{idx + 1}. {p.titulo}</strong>
                    <span style="font-size:11.5px;font-weight:600;color:var(--teal);background:var(--teal-pale);padding:2px 8px;border-radius:var(--r-btn);border:1px solid var(--line-teal);">{p.tag}</span>
                  </div>
                  <p style="font-size:14px;line-height:1.55;color:var(--fg-mid);margin:0;">{p.descricao}</p>
                </div>
              </div>
            ))}
          </div>

          <div style="background:var(--bg-subtle, #f8fafc);border:1px solid var(--border);border-left:4px solid var(--navy);border-radius:var(--r-btn);padding:14px 18px;margin-top:16px;font-size:13.5px;color:var(--fg-mid);line-height:1.6;">
            <strong>Importante no JEC (Regra da Petição Inicial):</strong> Diferente da Justiça Comum, no Juizado Especial Cível todas as provas documentais devem acompanhar a petição de atermação ou a peça inicial do Advogado. Se faltar a prova mínima da ocorrência ou do dano material, a empresa ré poderá alegar ausência de provas e o processo corre sério risco de improcedência.
          </div>
        </section>
      )}

      <ImageSlot
        variant="body"
        tag={tema.slug === 'transporte-aereo' ? "Infográfico Probatório · Res. 400 ANAC" : `Infográfico Probatório · ${tema.nome}`}
        titulo={tema.slug === 'transporte-aereo' ? "Anatomia da Prova: Elementos indispensáveis do registro fotográfico e documental no aeroporto" : `Dossiê Probatório: Documentos essenciais em ações de ${tema.nome.toLowerCase()}`}
        legenda={tema.slug === 'transporte-aereo' ? "Exemplo esquemático dos 5 pontos de prova que o passageiro deve registrar imediatamente após atraso > 4h ou cancelamento de voo." : `Checklist visual dos documentos que comprovam a falha de serviço e evitam a improcedência no Juizado Especial Cível.`}
        dimensao="760 × 380 px"
        icone={tema.icone}
        numero={1}
      />

      <div style="margin-top:36px;margin-bottom:20px;">
        <span class="post-vinheta" style="font-size:12px;margin-bottom:6px;">Jurisprudência & Guias Práticos no JEC</span>
        <h2 id="artigos" style="font-size:clamp(22px, 2.6vw, 28px);font-weight:700;color:var(--navy);margin:4px 0 10px;line-height:1.25;">
          {detalhe?.tituloSecaoGuias || `Artigos e guias especializados sobre ${tema.nome.toLowerCase()}`}
        </h2>
        <p style="font-size:15px;color:var(--fg-mid);line-height:1.65;margin:0;">
          {detalhe?.subtituloSecaoGuias || `Análises técnicas e orientações fundamentadas em decisões reais do Tribunal de Justiça de São Paulo:`}
        </p>
      </div>

      {artigos.length ? (
        <div class="slots">{artigos.map((a) => (
          <a class="nx" href={`/${tema.slug}/${a.data.slug}/`}><span class="tcard-ic"><Icon name={tema.icone} /></span><span class="nx-b"><span class="nx-t">{a.data.titulo}</span><span class="nx-m">{a.data.trilha && <span style="font-size:10.5px;font-weight:700;color:var(--teal);background:var(--teal-pale);padding:1px 6px;border-radius:4px;margin-right:6px;border:1px solid var(--line-teal);">Ep. {a.data.trilha.episodio}</span>}<span class={`post-fmt fmt-${a.data.formato}`}>{a.data.formato === 'guia' ? 'Guia' : 'Análise'}</span>{data(a.data.publicado)} · {a.data.leitura} min de leitura</span></span><span class="nx-go"><Icon name="arrow-right" size={16} stroke={2.2} /></span></a>
        ))}</div>
      ) : detalhe && detalhe.guiasPrevistos.length > 0 ? (
        <div class="slots">
          {detalhe.guiasPrevistos.map((g) => (
            <a class="nx" href="/#verificar" data-open-case data-cat={tema.slug} style="cursor:pointer;">
              <span class="tcard-ic"><Icon name={g.icone || tema.icone} /></span>
              <span class="nx-b">
                <span class="nx-t">{g.titulo}</span>
                <span class="nx-m">
                  <span class={`post-fmt fmt-${g.formato}`}>{g.formato === 'guia' ? 'Guia Prático' : 'Análise TJSP'}</span>
                  {g.leitura} min de leitura · {g.linha}
                </span>
              </span>
              <span class="nx-go"><Icon name="arrow-right" size={16} stroke={2.2} /></span>
            </a>
          ))}
        </div>
      ) : (
        <p>Os artigos aprofundados deste pilar estão em fase final de produção pela redação técnica. Enquanto isso, se você foi prejudicado por {tema.nome.toLowerCase()}, pode avaliar preliminarmente sua situação.</p>
      )}
      <aside class="cta-in"><div><b>Sofreu prejuízo com {tema.nome.toLowerCase()}?</b><span>Avalie preliminarmente sua situação e saiba quais documentos indispensáveis você deve reunir antes de procurar o Juizado ou um Advogado.</span></div><a class="btn btn-primary" href="/#verificar" data-open-case data-cat={tema.slug}>Avaliar minha situação <Icon name="arrow-right" size={16} stroke={2.2} /></a></aside>

      <div class="legal-parity-card" style="margin:28px 0 36px;background:var(--surface);border:1px solid var(--border);border-left:4px solid var(--teal);border-radius:var(--r);padding:24px 26px;box-shadow:var(--shadow);">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;">
          <span style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:var(--r-btn);background:var(--teal-pale);color:var(--teal);flex-shrink:0;"><Icon name="shield" size={20} stroke={2} /></span>
          <div>
            <span class="post-vinheta" style="margin-bottom:2px;font-size:11.5px;">Defesa Técnica e Paridade de Armas</span>
            <h4 style="font-size:17.5px;font-weight:700;color:var(--navy);margin:0;line-height:1.3;">Procure um Advogado Especializado em Juizados Especiais Cíveis (JEC)</h4>
          </div>
        </div>
        <p style="font-size:14.5px;line-height:1.65;color:var(--fg-mid);margin:0 0 12px;">
          Em litígios no Juizado Especial Cível, as empresas rés (instituições bancárias, operadoras de telecomunicações, companhias aéreas e concessionárias) comparecem <strong>sempre assistidas por bancas jurídicas experientes e prepostos capacitados</strong> para audiências de conciliação e instrução.
        </p>
        <p style="font-size:14px;line-height:1.65;color:var(--fg-mid);margin:0 0 14px;">
          Embora o artigo 9º da Lei 9.099/1995 autorize o cidadão a ajuizar ações de até 20 salários mínimos desacompanhado de patrono (<em>jus postulandi</em>), a assistência de um <strong>Advogado especializado em Juizados Especiais Cíveis</strong> é determinante para restabelecer a <strong style="color:var(--navy)">paridade de armas</strong> e assegurar o rigor técnico indispensável:
        </p>
        <ul style="font-size:13.5px;line-height:1.6;color:var(--fg-mid);margin:0 0 16px;padding-left:20px;display:flex;flex-direction:column;gap:8px;">
          <li><strong>Prevenção da preclusão probatória:</strong> No rito sumaríssimo do JEC, todos os documentos essenciais devem acompanhar a petição inicial, sob risco de preclusão e improcedência por deficiência probatória.</li>
          <li><strong>Formulação técnica de pedidos e tutelas de urgência:</strong> Adequada postulação de medidas liminares (para baixa de negativações ou cessação imediata de cobranças indevidas), inversão do ônus da prova (art. 6º, VIII do CDC), repetição do indébito em dobro (art. 42, parágrafo único do CDC) e fixação de <em>astreintes</em> (multas diárias cominatórias).</li>
          <li><strong>Atuação em audiência e fase recursal privativa:</strong> Enfrentamento das preliminares e defesas da empresa ré, além de representação privativa por advogado caso haja interposição de Recurso Inominado ao Colégio Recursal (art. 41, § 2º da Lei 9.099/95).</li>
        </ul>
        <div style="background:var(--bg-subtle, #f8fafc);border:1px solid var(--border);border-radius:var(--r-btn);padding:14px 18px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px;">
          <span style="font-size:13.5px;font-weight:600;color:var(--navy);">Para assegurar sua defesa técnica especializada, consulte sempre um Advogado regularmente inscrito na OAB.</span>
          <a href="/#verificar" class="btn btn-outline" style="font-size:13px;padding:7px 16px;" data-open-case data-cat={tema.slug}>Organizar documentos prévios <Icon name="arrow-right" size={14} /></a>
        </div>
      </div>
    </div>
    <aside class="inst-toc" style="display:flex;flex-direction:column;gap:20px">
      <ImageSlot
        variant="side"
        tag="Kit Probatório"
        titulo={tema.slug === 'transporte-aereo' ? "Checklist Visual do Passageiro" : "Documentação Obrigatória"}
        legenda={tema.slug === 'transporte-aereo' ? "Consulte os documentos obrigatórios antes de acionar o JEC." : "Requisitos essenciais para a petição inicial no Juizado."}
        dimensao="280 × 160 px"
        icone="doc"
      />
      <AdSlot variant="side" />
      <a class="side-cta" href="/#verificar" data-open-case data-cat={tema.slug} style="background:var(--surface);border:1px solid var(--border);border-left:3px solid var(--teal);padding:14px 16px;border-radius:var(--r);text-decoration:none;display:block;box-shadow:var(--shadow);">
        <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--teal);display:block;margin-bottom:4px;">Diagnóstico Preliminar</span>
        <span style="font-size:13.5px;font-weight:600;color:var(--navy);line-height:1.4;display:block;">Avalie as chances e os documentos do seu caso no JEC</span>
      </a>
    </aside>
  </div>

  <div style="margin:44px auto 24px;max-width:1170px;padding:0 16px;">
    <AdSlot variant="wide" />
  </div>

  {topOutro && (
    <section class="inst-correlatos" style="margin-top:64px;padding-top:48px;border-top:1px solid var(--border)">
      <div class="section-head" style="text-align:left;margin-bottom:28px">
        <div class="section-eyebrow">{GRUPOS[tema.grupo]}</div>
        <h2 class="section-title">{tituloSecao}</h2>
        <p class="section-sub">{subtituloSecao}</p>
      </div>

      <div class="feat-grid">
        <a class="feat" href={`/${topOutro.slug}/`}>
          <div class="feat-vis" style="min-height:220px;padding:26px;">
            <div class="fv-main">
              <div class="fv-n">{topOutro.procedenciaPct.toFixed(1).replace('.', ',')}%</div>
              <div class="fv-l">decisões favoráveis no TJSP</div>
            </div>
            <div class="tcard-metric" style="margin:0;background:var(--surface);padding:10px 14px;border-radius:var(--r);width:100%;max-width:240px;box-shadow:var(--shadow);">
              <div class="tcard-bar-wrap">
                <div class="tcard-bar-fill" style={`width:${topOutro.procedenciaPct}%`}></div>
              </div>
              <div class="tcard-stats-line">
                <span class="tcard-win"><strong>{topOutro.procedenciaPct.toFixed(1).replace('.', ',')}%</strong> ganharam</span>
                <span class="tcard-loss"><strong>{(100 - topOutro.procedenciaPct).toFixed(1).replace('.', ',')}%</strong> perderam</span>
              </div>
            </div>
          </div>
          <div class="feat-body">
            <span class="feat-tag">{GRUPOS[topOutro.grupo]} · {fmt(topOutro.decisoes)} decisões</span>
            <h3 class="feat-t">{topOutro.nome}</h3>
            <p style="font-size:14.5px;color:var(--fg-mid);line-height:1.6;margin:0 0 16px;">{topOutro.linha}</p>
            <div class="tcard-f" style="padding-top:12px;margin-top:auto;">
              <span class="tcard-hook">{topOutro.hookCuriosidade}</span>
              <span class="tcard-go">Ver tema <Icon name="arrow-right" size={14} stroke={2.2} /></span>
            </div>
          </div>
        </a>

        <div class="slots">
          <div class="slots-h">{slotsH}</div>
          {sideOutros.map((t) => (
            <a class="nx" href={`/${t.slug}/`}>
              <span class="tcard-ic"><Icon name={t.icone} /></span>
              <span class="nx-b">
                <span class="nx-t">{t.nome}</span>
                <span class="nx-m">
                  <span class="post-fmt fmt-analise" style="height:20px;padding:0 8px;font-size:11px;margin-right:6px;">{t.procedenciaPct.toFixed(1).replace('.', ',')}% êxito</span>
                  {fmt(t.decisoes)} decisões · {t.hookCuriosidade}
                </span>
              </span>
              <span class="nx-go"><Icon name="arrow-right" size={16} stroke={2.2} /></span>
            </a>
          ))}
          <a class="nx-all" href="/#temas">Ver todos os 14 temas do JEC <Icon name="arrow-right" size={16} stroke={2.2} /></a>
        </div>
      </div>

      {maisOutros.length > 0 && (
        <div style="margin-top:20px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:13.5px;color:var(--fg-muted);">
          <span>Mais temas deste segmento:</span>
          {maisOutros.map((m) => (
            <a href={`/${m.slug}/`} style="color:var(--teal);font-weight:600;text-decoration:none;background:var(--teal-pale);padding:5px 12px;border-radius:var(--r-btn);font-size:13px;border:1px solid var(--line-teal);">
              {m.nome} ({m.procedenciaPct.toFixed(1).replace('.', ',')}%)
            </a>
          ))}
        </div>
      )}
    </section>
  )}
</main>
</BaseLayout>
