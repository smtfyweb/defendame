---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import AdSlot from '../../components/article/AdSlot.astro';
import ImageSlot from '../../components/article/ImageSlot.astro';
import JurimetricsPanel from '../../components/themes/JurimetricsPanel.astro';
import EvidenceChecklist from '../../components/themes/EvidenceChecklist.astro';
import LegalParityCard from '../../components/themes/LegalParityCard.astro';
import { TEMAS, GRUPOS, fmt, getSecaoCorrelatos, getIconeArtigo, type Tema } from '../../data/temas';
import { getTemaDetalhamento } from '../../data/temasDetalhamento';
import { SITE } from '../../data/site';

export function getStaticPaths() { return TEMAS.map((t) => ({ params: { tema: t.slug }, props: { tema: t } })); }
const { tema } = Astro.props as { tema: Tema };
const artigos = (await getCollection('artigos', ({ data }) => data.tema === tema.slug && (import.meta.env.DEV || !data.rascunho)))
  .sort((a, b) => {
    if (a.data.trilha && b.data.trilha && a.data.trilha.slug === b.data.trilha.slug) {
      return a.data.trilha.episodio - b.data.trilha.episodio;
    }
    return +b.data.publicado - +a.data.publicado;
  });

const detalhe = getTemaDetalhamento(tema.slug);
const secao = getSecaoCorrelatos(tema.slug);
const topOutro = secao.top;
const sideOutros = secao.side;
const maisOutros = secao.maisDoGrupo;
const tituloSecao = secao.titulo;
const subtituloSecao = secao.subtitulo;
const slotsH = secao.slotsH;

const data = (d: Date) => d.toLocaleDateString('pt-BR', { timeZone: 'UTC' });
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: `${tema.seoH1 || tema.nome} no Juizado Especial Cível`, url: new URL(`/${tema.slug}/`, SITE.url).href,
  breadcrumb: { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Início', item: SITE.url }, { '@type': 'ListItem', position: 2, name: tema.nome }] } }];
---
<BaseLayout title={`${tema.seoH1 || tema.nome} — ${SITE.name}`} description={`${tema.linha}. Artigos e dados de ${fmt(tema.decisoes)} decisões do TJSP sobre ${tema.nome.toLowerCase()} no Juizado Especial Cível.`} jsonLd={jsonLd}>
<main class="inst">
  <div class="inst-head">
    <nav class="crumb" aria-label="Navegação"><a href="/">Início</a><span>›</span><a href="/#temas">Temas</a><span>›</span><span class="crumb-cur">{tema.nome}</span></nav>
    <span class="post-vinheta">{GRUPOS[tema.grupo]} · {tema.nome}</span>
    <h1 set:html={tema.seoH1Html || tema.seoH1 || tema.nome} />
    <p>{tema.linha}. Análise técnica de {fmt(tema.decisoes)} decisões judiciais do TJSP: entenda seus direitos, descubra o que separa quem ganha de quem perde e veja os precedentes consolidados.</p>
  </div>

  <!-- Painel Jurimétrico Modular com Ficha Técnica -->
  <JurimetricsPanel tema={tema} detalhe={detalhe} />

  <div class="inst-wrap">
    <div class="doc">
      <!-- Curadoria Probatória Modular -->
      {detalhe?.provasIndispensaveis && (
        <EvidenceChecklist provas={detalhe.provasIndispensaveis} tema={tema} />
      )}

      <ImageSlot
        variant="body"
        tag={tema.slug === 'transporte-aereo' ? "Infográfico Probatório · Res. 400 ANAC" : `Infográfico Probatório · ${tema.nome}`}
        titulo={tema.slug === 'transporte-aereo' ? "Anatomia da Prova: Elementos indispensáveis do registro fotográfico e documental no aeroporto" : `Dossiê Probatório: Documentos essenciais em ações de ${tema.nome.toLowerCase()}`}
        legenda={tema.slug === 'transporte-aereo' ? "Exemplo esquemático dos 5 pontos de prova que o passageiro deve registrar imediatamente após atraso superior a 4h ou cancelamento de voo." : `Checklist visual dos documentos que comprovam a falha de serviço e evitam a improcedência no Juizado Especial Cível.`}
        dimensao="760 × 380 px"
        icone={tema.icone}
        numero={1}
      />

      <div style="margin-top:36px;margin-bottom:20px;">
        <span class="post-vinheta" style="font-size:12px;margin-bottom:6px;">Trilha Editorial & Jurisprudência TJSP</span>
        <h2 id="artigos" style="font-size:clamp(22px, 2.6vw, 28px);font-weight:700;color:var(--navy);margin:4px 0 10px;line-height:1.25;">
          <span set:html={tema.secaoGuiasH2Html || tema.secaoGuiasH2 || detalhe?.tituloSecaoGuias || `Artigos e guias especializados sobre ${tema.nome.toLowerCase()} no JEC`} />
        </h2>
        <p style="font-size:15px;color:var(--fg-mid);line-height:1.65;margin:0;">
          {tema.secaoGuiasSub || detalhe?.subtituloSecaoGuias || `Análises técnicas, roteiros práticos e orientações fundamentadas em decisões reais do Tribunal de Justiça de São Paulo:`}
        </p>
      </div>

      {artigos.length ? (
        <div class="slots" data-motion>{artigos.map((a, i) => (
          <a class="nx" data-reveal style={`--i:${i}`} href={`/${tema.slug}/${a.data.slug}/`}><span class="tcard-ic"><Icon name={getIconeArtigo(a.data.slug, tema.icone, a.data.icone)} /></span><span class="nx-b"><span class="nx-t">{a.data.titulo}</span><span class="nx-m">{a.data.trilha && <span style="font-size:10.5px;font-weight:700;color:var(--teal);background:var(--teal-pale);padding:1px 6px;border-radius:4px;margin-right:6px;border:1px solid var(--line-teal);">Ep. {a.data.trilha.episodio}</span>}<span class={`post-fmt fmt-${a.data.formato}`}>{a.data.formato === 'guia' ? 'Guia' : 'Análise'}</span>{data(a.data.publicado)} · {a.data.leitura} min de leitura</span></span><span class="nx-go"><Icon name="arrow-right" size={16} stroke={2.2} /></span></a>
        ))}</div>
      ) : detalhe && detalhe.guiasPrevistos.length > 0 ? (
        <div class="slots" data-motion>
          {detalhe.guiasPrevistos.map((g, i) => (
            <a class="nx" href="/#verificar" data-open-case data-cat={tema.slug} data-reveal style={`--i:${i};cursor:pointer;`}>
              <span class="tcard-ic"><Icon name={g.icone || tema.icone} /></span>
              <span class="nx-b">
                <span class="nx-t">{g.titulo}</span>
                <span class="nx-m">
                  <span class={`post-fmt fmt-${g.formato}`}>{g.formato === 'guia' ? 'Guia Prático' : 'Análise TJSP'}</span>
                  {g.leitura} min de leitura · {g.linha}
                </span>
              </span>
              <span class="nx-go"><Icon name="arrow-right" size={16} stroke={2.2} /></span>
            </a>
          ))}
        </div>
      ) : (
        <p>Os artigos aprofundados deste pilar estão em fase final de produção pela redação técnica. Enquanto isso, se você foi prejudicado por {tema.nome.toLowerCase()}, pode avaliar preliminarmente sua situação.</p>
      )}

      <aside class="cta-in" data-motion data-reveal>
        <div>
          <b>Sofreu prejuízo com {tema.nome.toLowerCase()}?</b>
          <span>Avalie preliminarmente sua situação e saiba quais documentos indispensáveis você deve reunir antes de procurar o Juizado ou um Advogado.</span>
        </div>
        <a class="btn btn-primary" href="/#verificar" data-open-case data-cat={tema.slug}>
          Avaliar minha situação <Icon name="arrow-right" size={16} stroke={2.2} />
        </a>
      </aside>

      <!-- Card de Paridade e Assistência Técnica -->
      <LegalParityCard tema={tema} />
    </div>

    <!-- Barra Lateral: Imagem, AdSlot e CTA Preservados -->
    <aside class="inst-toc" style="display:flex;flex-direction:column;gap:20px">
      <ImageSlot
        variant="side"
        tag="Kit Probatório"
        titulo={tema.slug === 'transporte-aereo' ? "Checklist Visual do Passageiro" : "Documentação Obrigatória"}
        legenda={tema.slug === 'transporte-aereo' ? "Consulte os documentos obrigatórios antes de acionar o JEC." : "Requisitos essenciais para a petição inicial no Juizado."}
        dimensao="280 × 160 px"
        icone="doc"
      />
      <!-- AdSlot Lateral Preservado -->
      <AdSlot variant="side" />
      <a class="side-cta" href="/#verificar" data-open-case data-cat={tema.slug} style="background:var(--surface);border:1px solid var(--border);border-left:3px solid var(--teal);padding:14px 16px;border-radius:var(--r);text-decoration:none;display:block;box-shadow:var(--shadow);">
        <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--teal);display:block;margin-bottom:4px;">Diagnóstico Preliminar</span>
        <span style="font-size:13.5px;font-weight:600;color:var(--navy);line-height:1.4;display:block;">Avalie as chances e os documentos do seu caso no JEC</span>
      </a>
    </aside>
  </div>

  <!-- AdSlot Amplo / Footer Preservado -->
  <div style="margin:44px auto 24px;max-width:1170px;padding:0 16px;">
    <AdSlot variant="wide" />
  </div>

  {topOutro && (
    <section class="inst-correlatos" style="margin-top:64px;padding-top:48px;border-top:1px solid var(--border)">
      <div class="section-head sh-left">
        <div class="section-eyebrow">{GRUPOS[tema.grupo]}</div>
        <h2 class="section-title" set:html={secao.tituloHtml || tituloSecao} />
        <p class="section-sub">{subtituloSecao}</p>
      </div>

      <div class="feat-grid" data-motion>
        <a class="feat" data-reveal style="--i:0" href={`/${topOutro.slug}/`}>
          <div class="feat-vis">
            <div class="fv-main">
              <div class="fv-n" data-count-auto data-delay="250">{topOutro.procedenciaPct.toFixed(1).replace('.', ',')}%</div>
              <div class="fv-l">decisões favoráveis no TJSP</div>
            </div>
            <div class="tcard-metric feat-metric">
              <div class="tcard-bar-wrap">
                <div class="tcard-bar-fill" data-bar style={`--w:${topOutro.procedenciaPct}%`}></div>
              </div>
              <div class="tcard-stats-line">
                <span class="tcard-win"><strong data-count-auto data-delay="250">{topOutro.procedenciaPct.toFixed(1).replace('.', ',')}%</strong> procedentes</span>
                <span class="tcard-loss"><strong data-count-auto data-delay="250">{(100 - topOutro.procedenciaPct).toFixed(1).replace('.', ',')}%</strong> não procedentes</span>
              </div>
            </div>
          </div>
          <div class="feat-body">
            <span class="feat-tag">{GRUPOS[topOutro.grupo]} · {fmt(topOutro.decisoes)} decisões</span>
            <h3 class="feat-t">{topOutro.nome}</h3>
            <p class="feat-d">{topOutro.linha}</p>
            <div class="tcard-f feat-f">
              <span class="tcard-hook">{topOutro.hookCuriosidade}</span>
              <span class="tcard-go">Ver tema <Icon name="arrow-right" size={14} stroke={2.2} /></span>
            </div>
          </div>
        </a>

        <div class="slots" data-reveal style="--i:2">
          <div class="slots-h">{slotsH}</div>
          {sideOutros.map((t) => (
            <a class="nx" href={`/${t.slug}/`}>
              <span class="tcard-ic"><Icon name={t.icone} /></span>
              <span class="nx-b">
                <span class="nx-t">{t.nome}</span>
                <span class="nx-m">
                  <span class="post-fmt fmt-analise" style="height:20px;padding:0 8px;font-size:11px;margin-right:6px;">{t.procedenciaPct.toFixed(1).replace('.', ',')}% êxito</span>
                  {fmt(t.decisoes)} decisões · {t.hookCuriosidade}
                </span>
              </span>
              <span class="nx-go"><Icon name="arrow-right" size={16} stroke={2.2} /></span>
            </a>
          ))}
          <a class="nx-all" href="/#temas">Ver todos os 14 temas do JEC <Icon name="arrow-right" size={16} stroke={2.2} /></a>
        </div>
      </div>

      {maisOutros.length > 0 && (
        <div style="margin-top:20px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:13.5px;color:var(--fg-muted);">
          <span>Mais temas deste segmento:</span>
          {maisOutros.map((m) => (
            <a href={`/${m.slug}/`} style="color:var(--teal);font-weight:600;text-decoration:none;background:var(--teal-pale);padding:5px 12px;border-radius:var(--r-btn);font-size:13px;border:1px solid var(--line-teal);">
              {m.nome} [{m.procedenciaPct.toFixed(1).replace('.', ',')}%]
            </a>
          ))}
        </div>
      )}
    </section>
  )}
</main>
</BaseLayout>

<script>
  // Passar o mouse num número destaca o trecho correspondente da barra de distribuição
  document.querySelectorAll<HTMLElement>('.jd-panel').forEach((panel) => {
    const bar = panel.querySelector<HTMLElement>('.dist-bar');
    if (!bar) return;
    panel.querySelectorAll<HTMLElement>('.jd-stat').forEach((st, i) => {
      st.addEventListener('mouseenter', () => bar.setAttribute('data-hl', String(i)));
      st.addEventListener('mouseleave', () => bar.removeAttribute('data-hl'));
    });
  });
</script>
