---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import * as C from '../../components/article/index';

export async function getStaticPaths() {
  const artigos = await getCollection('artigos', ({ data }) => import.meta.env.DEV || !data.rascunho);
  return artigos.map((entry) => ({ params: { tema: entry.data.tema, slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<ArticleLayout entry={entry} headings={headings}>
  <Content components={C} />
</ArticleLayout>
