---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import AdSlot from '../components/article/AdSlot.astro';
import ImageSlot from '../components/article/ImageSlot.astro';
import { GLOSSARIO_JEC } from '../data/glossario';
import { SITE } from '../data/site';

const letras = Array.from(new Set(GLOSSARIO_JEC.map((g) => g.letra))).sort();
const total = GLOSSARIO_JEC.length;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'DefinedTermSet',
    name: 'Glossário Jurídico do Juizado Especial Cível (JEC)',
    description: 'Vocabulário jurídico do JEC em linguagem clara e acessível, com base no vocabulário oficial do Tribunal de Justiça de São Paulo (TJSP) e na Lei 9.099/1995.',
    url: new URL('/glossario/', SITE.url).href,
    inLanguage: 'pt-BR',
    hasDefinedTerm: GLOSSARIO_JEC.map((item) => ({
      '@type': 'DefinedTerm',
      name: item.termo,
      description: item.definicao,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Glossário Jurídico' },
    ],
  },
];
---
<BaseLayout
  title="Glossário Jurídico do JEC — Vocabulário Oficial do TJSP | DefendaMe"
  description="Dicionário de termos do Juizado Especial Cível (JEC) em linguagem clara. Baseado no Vocabulário Jurídico do TJSP e na Lei 9.099/1995 para descomplicar seus direitos."
  jsonLd={jsonLd}
>
  <main class="glossario-page">
    <div class="glossario-hero">
      <div class="glossario-hero-inner">
        <nav class="crumb" aria-label="Navegação"><a href="/">Início</a><span>›</span><span class="crumb-cur">Glossário Jurídico</span></nav>
        <div class="post-vinheta">Vocabulário Oficial do TJSP · Lei 9.099/1995</div>
        <h1>Glossário Jurídico do Juizado Especial Cível</h1>
        <p class="glossario-lead">
          Entenda o significado dos termos processuais mais frequentes em causas do JEC e direitos do consumidor. Descomplicamos os jargões para você acompanhar seu processo com clareza e segurança.
        </p>

        <div class="glossario-search-wrap">
          <div class="glossario-search-box">
            <Icon name="search" size={20} stroke={2} />
            <input
              type="search"
              id="glossarioSearch"
              placeholder="Pesquisar termo... Ex.: Atermação, Revelia, Dano moral, Preclusão, Astreintes…"
              autocomplete="off"
              aria-label="Pesquisar termo jurídico"
            />
            <button type="button" id="clearSearch" aria-label="Limpar pesquisa" hidden>×</button>
          </div>
          <div class="glossario-count"><span id="matchCount">{total}</span> de {total} termos catalogados</div>
        </div>

        <div class="glossario-alpha-nav" id="alphaNav" role="navigation" aria-label="Filtro por letra inicial">
          <button type="button" class="alpha-btn on" data-letter="all">Todos</button>
          {letras.map((l) => (
            <button type="button" class="alpha-btn" data-letter={l}>{l}</button>
          ))}
        </div>
      </div>
    </div>

    <div class="glossario-container">
      <div class="glossario-source-note">
        <div class="gsn-icon"><Icon name="shield" size={22} stroke={2} /></div>
        <div class="gsn-text">
          <strong>Fonte oficial e rigor informativo:</strong>
          Os verbetes deste vocabulário têm como base primária o <a href="https://www.tjsp.jus.br/JuizadosEspeciais/JuizadosEspeciais/VocabularioJuridico" target="_blank" rel="noopener noreferrer">Glossário – Vocabulário Jurídico do Tribunal de Justiça de São Paulo (TJSP)</a>, acrescidos dos conceitos processuais fundamentais da Lei Federal nº 9.099/1995 e do Código de Defesa do Consumidor (CDC). Conteúdo estritamente informativo e educativo, nos termos do Provimento CFOAB nº 205/2021.
        </div>
      </div>

      <ImageSlot
        variant="wide"
        tag="Infográfico Didático · Vocabulário Jurídico"
        titulo="Linha do Tempo dos Termos Processuais: Da Atermação ao Cumprimento de Sentença"
        legenda="Diagrama explicativo conectando os verbetes técnicos do vocabulário do TJSP com os momentos práticos do processo no JEC."
        dimensao="860 × 280 px"
        icone="doc"
        numero={1}
      />

      <div class="glossario-grid" id="glossarioGrid">
        {GLOSSARIO_JEC.map((item, idx) => (
          <>
            {idx === Math.floor(total / 2) && (
              <div class="glossario-mid-ad" style="grid-column: 1 / -1; margin: 20px 0;">
                <AdSlot variant="wide" />
              </div>
            )}
            <article class="g-card" data-motion data-reveal style={`--i:${idx % 3}`} data-term={item.termo.toLowerCase()} data-letter={item.letra}>
              <div class="g-card-top">
                <span class="g-card-letter">{item.letra}</span>
                <h2 class="g-card-term">{item.termo}</h2>
              </div>
              <p class="g-card-def">{item.definicao}</p>
            </article>
          </>
        ))}
      </div>

      <div class="g-empty" id="emptyState" hidden>
        <div class="g-empty-icon"><Icon name="search" size={36} stroke={1.8} /></div>
        <h3>Nenhum termo encontrado</h3>
        <p>Não localizamos nenhum termo correspondente à sua busca. Tente buscar por palavras similares ou explore a lista alfabética.</p>
        <button type="button" class="btn btn-outline" id="btnResetSearch">Ver todos os termos</button>
      </div>

      <div style="margin:44px auto 28px;max-width:860px;padding:0 16px;">
        <AdSlot variant="wide" />
      </div>

      <div class="glossario-cta-box">
        <div class="gcta-content">
          <span class="post-vinheta" style="margin-bottom:8px;">Orientação Preliminar</span>
          <h3>Ficou com dúvidas sobre o significado de algum termo no seu caso?</h3>
          <p>
            Entenda a viabilidade da sua demanda e descubra quais documentos e provas indispensáveis você deve reunir antes de procurar o Juizado Especial Cível ou um Advogado.
          </p>
        </div>
        <div class="gcta-actions">
          <a href="/#verificar" class="btn btn-primary" data-open-case>Avaliar minha situação <Icon name="arrow-right" size={16} stroke={2.2} /></a>
          <a href="/#temas" class="btn btn-outline">Ver temas do JEC</a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .glossario-page {
    min-height: 80vh;
    padding-bottom: 80px;
  }
  .glossario-hero {
    background: linear-gradient(180deg, var(--bg-card) 0%, var(--bg) 100%);
    border-bottom: 1px solid var(--border);
    padding: 44px 20px 48px;
    text-align: left;
  }
  .glossario-hero-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .glossario-hero h1 {
    font-size: clamp(32px, 4.4vw, 48px);
    font-weight: 400;
    letter-spacing: -0.04em;
    color: var(--navy);
    line-height: 1.1;
    margin: 14px 0 16px;
    text-wrap: balance;
  }
  .glossario-lead {
    font-size: 18px;
    line-height: 1.6;
    color: var(--fg-mid);
    max-width: 760px;
    margin: 0 0 32px;
  }
  .glossario-search-wrap {
    max-width: 620px;
    margin: 0 0 24px;
  }
  .glossario-search-box {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: var(--r-btn);
    padding: 6px 16px;
    box-shadow: var(--shadow);
    transition: border-color .2s, box-shadow .2s;
  }
  .glossario-search-box:focus-within {
    border-color: var(--teal);
    box-shadow: 0 0 0 4px var(--teal-pale);
  }
  .glossario-search-box input {
    border: none;
    outline: none;
    background: transparent;
    font-size: 16px;
    color: var(--navy);
    width: 100%;
    padding: 8px 0;
  }
  .glossario-search-box input::placeholder {
    color: var(--fg-muted);
  }
  .glossario-search-box button {
    background: none;
    border: none;
    color: var(--fg-muted);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    padding: 0 4px;
  }
  .glossario-count {
    font-size: 13.5px;
    color: var(--fg-muted);
    margin-top: 10px;
    font-weight: 500;
  }
  .glossario-alpha-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 6px;
    margin-top: 20px;
  }
  .alpha-btn {
    min-width: 34px;
    height: 34px;
    padding: 0 10px;
    border-radius: var(--r-btn);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--navy);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all .15s ease;
  }
  .alpha-btn:hover {
    border-color: var(--teal);
    color: var(--teal);
  }
  .alpha-btn.on {
    background: var(--teal);
    border-color: var(--teal);
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(11, 143, 130, .3);
  }
  .glossario-container {
    max-width: 1140px;
    margin: 40px auto 0;
    padding: 0 20px;
  }
  .glossario-source-note {
    background: none;
    border: 0;
    border-left: 2px solid var(--teal);
    border-radius: 0;
    padding: 4px 0 4px 20px;
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 36px;
  }
  .gsn-icon {
    color: var(--teal);
    flex-shrink: 0;
    margin-top: 2px;
  }
  .gsn-text {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--fg-mid);
  }
  .gsn-text a {
    color: var(--teal);
    text-decoration: underline;
    font-weight: 600;
  }
  .glossario-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 40px;
  }
  @media (max-width: 768px) {
    .glossario-grid {
      grid-template-columns: 1fr;
    }
  }
  .g-card {
    background: none;
    border: 0;
    border-top: 1px solid var(--border);
    border-radius: 0;
    padding: 22px 0;
    display: flex;
    flex-direction: column;
    transition: background .2s ease, padding .3s var(--ease-out);
  }
  .g-card:hover {
    background: var(--teal-pale);
    padding-left: 12px;
    padding-right: 12px;
  }
  .g-card-top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .g-card-letter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--teal-pale);
    color: var(--teal);
    font-size: 15px;
    font-weight: 700;
    flex-shrink: 0;
  }
  .g-card-term {
    font-size: 18px;
    font-weight: 700;
    color: var(--navy);
    margin: 0;
    line-height: 1.3;
  }
  .g-card-def {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--fg-mid);
    margin: 0;
  }
  .g-empty {
    text-align: center;
    padding: 60px 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    margin: 20px 0;
  }
  .g-empty-icon {
    color: var(--fg-muted);
    margin-bottom: 16px;
  }
  .g-empty h3 {
    font-size: 20px;
    color: var(--navy);
    margin: 0 0 8px;
  }
  .g-empty p {
    font-size: 15px;
    color: var(--fg-mid);
    max-width: 480px;
    margin: 0 auto 20px;
  }
  .glossario-cta-box {
    margin-top: 56px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 32px 36px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    box-shadow: var(--shadow);
  }
  @media (max-width: 860px) {
    .glossario-cta-box {
      flex-direction: column;
      text-align: center;
      padding: 28px 20px;
    }
  }
  .gcta-content h3 {
    font-size: 20px;
    font-weight: 700;
    color: var(--navy);
    margin: 0 0 8px;
  }
  .gcta-content p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--fg-mid);
    margin: 0;
    max-width: 620px;
  }
  .gcta-actions {
    display: flex;
    gap: 12px;
    flex-shrink: 0;
    flex-wrap: wrap;
  }
</style>

<script>
  const searchInput = document.getElementById('glossarioSearch') as HTMLInputElement;
  const clearBtn = document.getElementById('clearSearch') as HTMLButtonElement;
  const matchCount = document.getElementById('matchCount') as HTMLElement;
  const alphaButtons = document.querySelectorAll<HTMLButtonElement>('.alpha-btn');
  const cards = document.querySelectorAll<HTMLElement>('.g-card');
  const emptyState = document.getElementById('emptyState') as HTMLElement;
  const btnReset = document.getElementById('btnResetSearch') as HTMLButtonElement;

  let activeLetter = 'all';

  const norm = (s: string) =>
    s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

  function filterGlossario() {
    const raw = searchInput.value.trim();
    const terms = norm(raw).split(/\s+/).filter(Boolean);
    clearBtn.hidden = !raw;
    let visibleCount = 0;

    cards.forEach((card) => {
      const term = norm(card.dataset.term || '');
      const def = norm(card.querySelector('.g-card-def')?.textContent || '');
      const letter = card.dataset.letter || '';

      const matchLetter = activeLetter === 'all' || letter === activeLetter;
      const matchQuery = !terms.length || terms.every((t) => term.includes(t) || def.includes(t));

      if (matchLetter && matchQuery) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    matchCount.textContent = String(visibleCount);
    emptyState.hidden = visibleCount > 0;
    const midAd = document.querySelector<HTMLElement>('.glossario-mid-ad');
    if (midAd) midAd.style.display = (activeLetter === 'all' && !raw && visibleCount > 0) ? 'block' : 'none';
  }

  searchInput.addEventListener('input', () => {
    if (searchInput.value.trim() && activeLetter !== 'all') {
      activeLetter = 'all';
      alphaButtons.forEach((b) => b.classList.toggle('on', b.dataset.letter === 'all'));
    }
    filterGlossario();
  });

  clearBtn.addEventListener('click', () => {
    searchInput.value = '';
    filterGlossario();
    searchInput.focus();
  });

  alphaButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      alphaButtons.forEach((b) => b.classList.remove('on'));
      btn.classList.add('on');
      activeLetter = btn.dataset.letter || 'all';
      filterGlossario();
    });
  });

  btnReset?.addEventListener('click', () => {
    searchInput.value = '';
    activeLetter = 'all';
    alphaButtons.forEach((b) => b.classList.toggle('on', b.dataset.letter === 'all'));
    filterGlossario();
  });
</script>
