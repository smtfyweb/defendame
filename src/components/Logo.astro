---
/** Logotipo DefendaMe: caixa "D" com seta de devolução + "efenda" + caixa "Me".
 *  As letras D/M/e são contornos reais da DM Sans 600. A cor da caixa vem de --logo-teal. */
interface Props { href?: string; class?: string }
import { b } from '../utils/url';
const { href = b(), class: cls } = Astro.props;
const cid = 'dcut-' + Math.random().toString(36).slice(2, 8);
---
<a href={href} class:list={['nav-logo', cls]} aria-label="DefendaMe — início"><span class="wm"><svg class="wm-svg" viewBox="0 0 925 1080" style="width:0.925em" aria-hidden="true"><rect width="925" height="1080" rx="190" fill="var(--logo-teal)"/><g transform="translate(120 890) scale(1 -1)" fill="#fff"><defs><clipPath id={cid}><path d="M-500 -500H2000V1500H-500Z M40 -130V270H280V-130Z" clip-rule="evenodd"/></clipPath></defs><path d="M71 0V700H297Q419 700 498.5 657.0Q578 614 616.5 535.5Q655 457 655 349Q655 243 616.5 164.5Q578 86 498.5 43.0Q419 0 297 0ZM191 102H291Q382 102 434.5 131.5Q487 161 509.5 216.5Q532 272 532 349Q532 427 509.5 482.5Q487 538 434.5 568.5Q382 599 291 599H191Z" clip-path="{`url(#${cid})`}" fill-rule="nonzero"/><path d="M10 51 L250 -112 V214 Z"/></g></svg><span class="wm-txt">efenda</span><svg class="wm-svg" viewBox="0 0 1620 1080" style="width:1.620em" aria-hidden="true"><rect width="1620" height="1080" rx="190" fill="var(--logo-teal)"/><g transform="translate(79 890) scale(1 -1)" fill="#fff"><path d="M71 0V700H213L437 248L659 700H802V0H682V494L484 98H390L191 493V0Z"/><path transform="translate(843 0)" d="M303 -12Q228 -12 171.0 20.5Q114 53 82.0 112.0Q50 171 50 248Q50 328 81.5 388.0Q113 448 170.5 482.0Q228 516 304 516Q378 516 433.0 483.0Q488 450 518.0 394.5Q548 339 548 270V248Q548 236 546 223H168Q171 185 186 156Q203 122 233.5 104.5Q264 87 302 87Q344 87 371.5 105.0Q399 123 412 153H534Q520 106 488.0 68.5Q456 31 409.0 9.5Q362 -12 303 -12ZM170 300H427Q425 355 390.0 386.5Q355 418 303 418Q266 418 235.0 401.0Q204 384 186 351Q174 329 170 300Z"/></g></svg></span></a>
