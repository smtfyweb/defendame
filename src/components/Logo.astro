---
/** Logotipo DefendaMe: "Defenda" fino + "Me" forte em verde; embaixo, botão "liga" aceso + "online".
 *  O mesmo botão é o favicon (public/favicon.svg) e o ícone do celular. */
interface Props { href?: string; class?: string }
const { href = '/', class: cls } = Astro.props;
const id = 'pw' + Math.random().toString(36).slice(2, 7);
---
<a href={href} class:list={['nav-logo', cls]} aria-label="DefendaMe online — início"><span class="wm"><span class="wm-n">Defenda<b>Me</b></span><span class="wm-d"><svg class="wm-pw" viewBox="0 0 64 64" aria-hidden="true"><defs><radialGradient id={`${id}g`} cx="38%" cy="28%" r="80%"><stop offset="0" stop-color="#4fd6c8"/><stop offset=".5" stop-color="#12857e"/><stop offset="1" stop-color="#0a4f4a"/></radialGradient><linearGradient id={`${id}r`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f4f8f8"/><stop offset=".5" stop-color="#a9bcbb"/><stop offset="1" stop-color="#5d7372"/></linearGradient><linearGradient id={`${id}h`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".55"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></linearGradient><filter id={`${id}f`} x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="2.2"/></filter></defs><circle cx="32" cy="33" r="30" fill="#000" opacity=".18"/><circle cx="32" cy="32" r="30" fill={`url(#${id}r)`}/><circle cx="32" cy="32" r="25.5" fill={`url(#${id}g)`}/><ellipse cx="32" cy="20" rx="17" ry="9" fill={`url(#${id}h)`}/><g class="wm-glow" stroke="#9ff7e0" stroke-width="7" stroke-linecap="round" fill="none" filter={`url(#${id}f)`} opacity=".9"><path d="M22.6 24.8a13 13 0 1 0 18.8 0"/><path d="M32 17v14"/></g><g stroke="#fff" stroke-width="4.4" stroke-linecap="round" fill="none"><path d="M22.6 24.8a13 13 0 1 0 18.8 0"/><path d="M32 17v14"/></g></svg>online</span></span></a>
