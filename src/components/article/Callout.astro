---
/** Caixa de ressalva/alerta (âmbar). Use para ressalvas metodológicas e avisos da OAB. */
import Icon from '../Icon.astro';
interface Props { titulo: string }
const { titulo } = Astro.props;
---
<div class="alert-box-warning"><div class="alert-header"><Icon name="alert" size={18} stroke={2} /><strong>{titulo}</strong></div><slot /></div>
