---
/** Caixa de ressalva/orientação técnica (variantes: info, warning, legal). */
import Icon from '../Icon.astro';
interface Props {
  titulo: string;
  tipo?: 'warning' | 'info' | 'legal';
}
const { titulo, tipo = 'info' } = Astro.props;
const isWarning = tipo === 'warning';
---
<div class={isWarning ? 'alert-box-warning' : 'alert-box-info'} data-motion data-reveal>
  <div class="alert-header">
    <Icon name={isWarning ? 'alert' : 'shield'} size={18} stroke={2} />
    <strong>{titulo}</strong>
  </div>
  <slot />
</div>
