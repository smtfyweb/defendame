---
/**
 * Componente ImageSlot: Espaço reservado e moldura para ilustrações técnicas,
 * infográficos e diagramas de prova (Below-the-Fold), com suporte a lazy-loading nativo.
 */
import Icon from '../Icon.astro';

interface Props {
  variant?: 'body' | 'side' | 'wide';
  tag?: string;
  titulo?: string;
  legenda?: string;
  numero?: number;
  dimensao?: string;
  icone?: string;
  src?: string;
  alt?: string;
}

const {
  variant = 'body',
  tag = 'Infográfico Técnico',
  titulo,
  legenda,
  numero,
  dimensao = variant === 'side' ? '280 × 160 px' : variant === 'wide' ? '1170 × 200 px' : '760 × 380 px',
  icone = 'chart',
  src,
  alt = titulo || 'Ilustração técnica e procedimental',
} = Astro.props;
---

<figure class={`img-slot-wrap img-slot-${variant}`}>
  {src ? (
    <div class="img-slot-media">
      <img src={src} alt={alt} loading="lazy" decoding="async" />
    </div>
  ) : (
    <div class="img-slot-placeholder">
      <div class="img-slot-header">
        <span class="img-slot-tag">{tag}</span>
        <span class="img-slot-dim">{dimensao}</span>
      </div>
      <div class="img-slot-center">
        <span class="img-slot-icon">
          <Icon name={icone} size={variant === 'side' ? 24 : 32} stroke={1.8} />
        </span>
        {titulo && <h4 class="img-slot-title">{titulo}</h4>}
        <p class="img-slot-sub">Espaço reservado para ativo visual educativo (Abaixo da 1ª dobra · Lazy-loaded)</p>
      </div>
    </div>
  )}

  {legenda && (
    <figcaption class="img-slot-caption">
      {numero && <strong>Figura {numero}: </strong>}
      <span>{legenda}</span>
    </figcaption>
  )}
</figure>

<style>
  .img-slot-wrap {
    margin: 32px 0;
    display: block;
  }
  .img-slot-side {
    margin: 16px 0;
  }
  .img-slot-placeholder {
    position: relative;
    background: linear-gradient(135deg, var(--teal-pale) 0%, var(--surface) 100%);
    border: 1.5px dashed var(--line-teal);
    border-radius: var(--r);
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 220px;
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .img-slot-side .img-slot-placeholder {
    min-height: 160px;
    padding: 16px 14px;
  }
  .img-slot-wide .img-slot-placeholder {
    min-height: 180px;
    max-width: 1170px;
    margin: 0 auto;
  }
  .img-slot-wide .img-slot-title {
    max-width: 720px;
  }
  .img-slot-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 12px;
  }
  .img-slot-tag {
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: var(--teal);
    background: var(--surface);
    padding: 3px 8px;
    border-radius: var(--r-btn);
    border: 1px solid var(--line-teal);
  }
  .img-slot-dim {
    font-size: 11px;
    font-weight: 600;
    color: var(--fg-muted);
    font-family: monospace;
    background: rgba(0,0,0,.04);
    padding: 2px 6px;
    border-radius: 4px;
  }
  .img-slot-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin: auto 0;
    gap: 8px;
  }
  .img-slot-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: var(--r-btn);
    background: var(--surface);
    color: var(--teal);
    box-shadow: var(--shadow);
    border: 1px solid var(--line-teal);
    margin-bottom: 4px;
  }
  .img-slot-side .img-slot-icon {
    width: 40px;
    height: 40px;
  }
  .img-slot-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--navy);
    margin: 0;
    line-height: 1.35;
    max-width: 480px;
  }
  .img-slot-side .img-slot-title {
    font-size: 13.5px;
    max-width: 100%;
  }
  .img-slot-sub {
    font-size: 12px;
    color: var(--fg-muted);
    margin: 0;
    line-height: 1.4;
  }
  .img-slot-caption {
    font-size: 13px;
    color: var(--fg-muted);
    line-height: 1.55;
    margin-top: 10px;
    padding: 0 4px;
  }
  .img-slot-caption strong {
    color: var(--navy);
  }
  .img-slot-media img {
    width: 100%;
    height: auto;
    border-radius: var(--r);
    display: block;
    border: 1px solid var(--border);
  }
</style>
