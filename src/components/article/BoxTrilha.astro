---
/**
 * Componente BoxTrilha: Módulo editorial "estilo Netflix" para retenção contínua e binge-reading.
 * variants:
 * - "topo": Exibe o progresso da série e o gancho do episódio anterior.
 * - "rodape": Apresenta a síntese ("Neste episódio você viu"), o teaser e o botão do próximo episódio.
 */
import Icon from '../Icon.astro';

interface TrilhaData {
  nome: string;
  slug: string;
  episodio: number;
  totalEpisodios: number;
  recap?: string[];
  anterior?: {
    titulo: string;
    slug: string;
    resumo?: string;
  };
  proximo?: {
    titulo: string;
    slug: string;
    teaser: string;
  };
}

interface Props {
  trilha: TrilhaData;
  variant?: 'topo' | 'rodape';
  temaSlug?: string;
}

const { trilha, variant = 'rodape', temaSlug } = Astro.props;
const getUrl = (slug: string) => slug.startsWith('/') ? slug : (temaSlug ? `/${temaSlug}/${slug}/` : `/${slug}/`);
---

{variant === 'topo' ? (
  <nav class="box-trilha box-trilha-topo" aria-label="Progresso da trilha editorial">
    <div class="trilha-header">
      <div class="trilha-badge">
        <span class="trilha-icon"><Icon name="layers" size={14} stroke={2.2} /></span>
        <span class="trilha-nome">{trilha.nome}</span>
      </div>
      <span class="trilha-progresso">Episódio {trilha.episodio} de {trilha.totalEpisodios}</span>
    </div>

    {trilha.anterior ? (
      <div class="trilha-prev-strip">
        <a href={getUrl(trilha.anterior.slug)} class="trilha-prev-link">
          <Icon name="arrow-left" size={13} stroke={2.2} />
          <span>Episódio anterior: <strong>{trilha.anterior.titulo}</strong></span>
        </a>
        {trilha.anterior.resumo && (
          <p class="trilha-prev-resumo">
            <em>Você viu:</em> {trilha.anterior.resumo}
          </p>
        )}
      </div>
    ) : (
      <p class="trilha-intro-note">
        Início da trilha prática. Siga os episódios em ordem para entender todas as etapas do processo.
      </p>
    )}
  </nav>
) : (
  <aside class="box-trilha box-trilha-rodape" aria-label="Continuidade da leitura">
    {trilha.recap && trilha.recap.length > 0 && (
      <div class="trilha-recap-box">
        <div class="trilha-recap-head">
          <Icon name="check" size={15} stroke={2.5} />
          <span>Neste episódio você viu:</span>
        </div>
        <ul class="trilha-recap-list">
          {trilha.recap.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    )}

    {trilha.proximo ? (
      <div class="trilha-next-box">
        <div class="trilha-next-teaser">
          <div class="trilha-next-tag">
            <span>No próximo episódio (Ep. {trilha.episodio + 1} de {trilha.totalEpisodios})</span>
            <Icon name="chevron-right" size={14} stroke={2.2} />
          </div>
          <h4 class="trilha-next-title">{trilha.proximo.titulo}</h4>
          <p class="trilha-next-desc">{trilha.proximo.teaser}</p>
        </div>
        <a href={getUrl(trilha.proximo.slug)} class="btn-trilha-next">
          <span>Ler próximo episódio</span>
          <Icon name="arrow-right" size={16} stroke={2.2} />
        </a>
      </div>
    ) : (
      <div class="trilha-end-box">
        <div class="trilha-end-icon"><Icon name="shield" size={24} stroke={2} /></div>
        <div class="trilha-end-text">
          <strong>Você concluiu todos os {trilha.totalEpisodios} episódios desta trilha.</strong>
          <p>Seus direitos e as provas essenciais foram mapeados. Se você foi prejudicado, consulte as regras e faça uma avaliação preliminar.</p>
        </div>
        {temaSlug && (
          <a href={`/${temaSlug}/`} class="btn btn-outline" style="font-size:13px;padding:6px 14px;">
            Ver guia completo do tema
          </a>
        )}
      </div>
    )}

    {trilha.anterior && (
      <div class="trilha-footer-nav">
        <a href={getUrl(trilha.anterior.slug)} class="trilha-back-btn">
          <Icon name="arrow-left" size={13} stroke={2.2} />
          <span>Voltar para: {trilha.anterior.titulo}</span>
        </a>
      </div>
    )}
  </aside>
)}

<style>
  .box-trilha {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  .box-trilha-topo {
    margin: 18px 0 24px;
    padding: 14px 18px;
    background: linear-gradient(180deg, var(--teal-pale) 0%, var(--surface) 100%);
    border-left: 4px solid var(--teal);
  }
  .trilha-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 8px;
  }
  .trilha-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: var(--teal);
  }
  .trilha-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 4px;
    background: var(--surface);
    border: 1px solid var(--line-teal);
  }
  .trilha-progresso {
    font-size: 11.5px;
    font-weight: 700;
    color: var(--fg-mid);
    background: var(--surface);
    padding: 2px 8px;
    border-radius: var(--r-btn);
    border: 1px solid var(--border);
  }
  .trilha-prev-strip {
    margin-top: 6px;
    padding-top: 8px;
    border-top: 1px dashed var(--line-teal);
  }
  .trilha-prev-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--teal);
    text-decoration: none;
    font-weight: 500;
  }
  .trilha-prev-link:hover {
    text-decoration: underline;
  }
  .trilha-prev-link strong {
    color: var(--navy);
  }
  .trilha-prev-resumo {
    font-size: 12px;
    color: var(--fg-mid);
    margin: 4px 0 0;
    line-height: 1.4;
  }
  .trilha-intro-note {
    font-size: 12.5px;
    color: var(--fg-mid);
    margin: 4px 0 0;
    line-height: 1.45;
  }
  .box-trilha-rodape {
    margin: 36px 0;
    padding: 24px;
    border-top: 3px solid var(--teal);
  }
  .trilha-recap-box {
    margin-bottom: 22px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border);
  }
  .trilha-recap-head {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: var(--teal);
    margin-bottom: 10px;
  }
  .trilha-recap-list {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14px;
    color: var(--fg-mid);
    line-height: 1.55;
  }
  .trilha-next-box {
    background: linear-gradient(135deg, var(--teal-pale) 0%, var(--surface) 100%);
    border: 1px solid var(--line-teal);
    border-radius: var(--r);
    padding: 20px 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }
  .trilha-next-teaser {
    flex: 1;
    min-width: 260px;
  }
  .trilha-next-tag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: var(--teal);
    margin-bottom: 6px;
  }
  .trilha-next-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--navy);
    margin: 0 0 6px;
    line-height: 1.35;
  }
  .trilha-next-desc {
    font-size: 13.5px;
    color: var(--fg-mid);
    line-height: 1.5;
    margin: 0;
  }
  .btn-trilha-next {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--teal);
    color: #ffffff !important;
    font-size: 14px;
    font-weight: 700;
    padding: 10px 18px;
    border-radius: var(--r-btn);
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(11, 143, 130, .25);
    transition: all .15s ease;
    flex-shrink: 0;
  }
  .btn-trilha-next:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(11, 143, 130, .35);
  }
  .trilha-end-box {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 18px;
    background: var(--bg-subtle, #f8fafc);
    border-radius: var(--r);
    border: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .trilha-end-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--r-btn);
    background: var(--teal-pale);
    color: var(--teal);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .trilha-end-text {
    flex: 1;
    min-width: 220px;
    font-size: 13.5px;
    color: var(--fg-mid);
    line-height: 1.5;
  }
  .trilha-end-text strong {
    color: var(--navy);
    display: block;
    margin-bottom: 2px;
  }
  .trilha-end-text p {
    margin: 0;
  }
  .trilha-footer-nav {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }
  .trilha-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    color: var(--fg-muted);
    text-decoration: none;
    font-weight: 500;
  }
  .trilha-back-btn:hover {
    color: var(--teal);
    text-decoration: underline;
  }
</style>
