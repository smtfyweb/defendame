---
/**
 * Citação jurídica inline limpa (Artigo de Lei, Súmula ou Precedente STJ/STF).
 * Renderiza em destaque tipográfico natural (stronger), limpo e perfeitamente integrado à prosa,
 * SEM caixas, SEM badges e SEM ícones decorativos.
 */
interface Props {
  art?: string;
  lei?: string;
  sumula?: string | number;
  tribunal?: string;
  resp?: string;
  tema?: string;
  texto?: string;
}
const { art, lei, sumula, tribunal, resp, tema, texto } = Astro.props;

let label = texto ?? '';
if (!label) {
  const parts: string[] = [];
  
  if (art) parts.push(art);
  
  if (lei) {
    if (art && !lei.startsWith('do ') && !lei.startsWith('da ') && !lei.startsWith('de ')) {
      const feminina = /^(anac|cf|constituição|lei|resolução)/i.test(lei.trim());
      parts.push(`${feminina ? 'da ' : 'do '}${lei}`);
    } else {
      parts.push(lei);
    }
  }
  
  if (sumula) {
    const s = String(sumula).trim();
    parts.push(s.toLowerCase().startsWith('súmula') ? s : `Súmula ${s}`);
  }
  
  if (tema) {
    const t = String(tema).trim();
    parts.push(t.toLowerCase().startsWith('tema') ? t : `Tema ${t}`);
  }
  
  if (resp) parts.push(resp);
  
  if (tribunal) {
    if (sumula || resp || tema) {
      parts.push(`do ${tribunal}`);
    } else {
      parts.push(tribunal);
    }
  }
  
  label = parts.join(' ');
}
---
<strong class="cite-legal">{label}</strong>
