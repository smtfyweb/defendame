---
/** Cartões numerados (ex.: "as 5 provas"). itens: [{ titulo, texto }] */
interface Props { itens: { titulo: string; texto: string }[] }
const { itens } = Astro.props;
---
<div class="proof-grid">
  {itens.map((it, i) => <div class="proof-card"><div class="proof-num">{i + 1}</div><div class="proof-title">{it.titulo}</div><div class="proof-desc">{it.texto}</div></div>)}
</div>
