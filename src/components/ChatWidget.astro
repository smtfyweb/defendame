    if (t.indexOf('enel') !== -1 || t.indexOf('cpfl') !== -1 || t.indexOf('energia') !== -1 || t.indexOf('luz') !== -1 || t.indexOf('sabesp') !== -1 || t.indexOf('comgás') !== -1 || t.indexOf('neoenergia') !== -1 || t.indexOf('edp') !== -1) return 'zap';
