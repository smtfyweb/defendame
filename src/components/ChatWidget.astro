    },
    'desvio-produtivo': {
      pergunta: '<p>Qual é <b>a empresa ou fornecedor</b> onde você perdeu tempo no SAC?</p>',
      opcoes: ['Claro / NET', 'Vivo / Telefônica', 'TIM', 'Banco Itaú', 'Banco Bradesco', 'Santander', 'Enel SP', 'Mercado Livre']
    },
    'superendividamento': {
      pergunta: '<p>Qual é <b>a principal instituição credora</b>?</p>',
      opcoes: ['Banco Itaú', 'Banco Bradesco', 'Santander', 'Caixa Econômica', 'Banco do Brasil', 'Banco Pan', 'Crefisa']
    },
    'acidente-de-transito': {
      pergunta: '<p>Qual é <b>a seguradora envolvida ou condutor</b>?</p>',
      opcoes: ['Porto Seguro', 'Bradesco Seguros', 'Azul Seguros', 'Tokio Marine', 'Allianz Seguros', 'HDI Seguros', 'Mapfre Seguros', 'Condutor Particular']
    }
  };

  var SERVICOS_SUGERIDOS = ['Telefonia ou Internet', 'Serviço Bancário', 'Energia Elétrica', 'Compra Online ou Loja', 'Plano de Saúde'];
  var BANCOS_SUGERIDOS = ['Nubank', 'Itaú', 'Bradesco', 'Santander', 'Banco C6', 'Caixa', 'Banco Inter'];
  var VALORES_SUGERIDOS = ['Até R$ 1.000', 'De R$ 1.000 a R$ 5.000', 'De R$ 5.000 a R$ 15.000', 'Acima de R$ 15.000'];
  var DATAS_SUGERIDAS = ['Hoje ou últimas 24 horas', 'Nos últimos 7 dias', 'Neste mês', 'Há mais de 30 dias'];

  // Estado da Sessão
  var caso = {
    origem: 'Chat Online',
    tag: 'chat',
    categoria: '',
    slug: '',
    protocolo: ''
  };

  var fieldsQueue = [];
  var fieldIdx = 0;

  // Etapa 1: Usuário escolhe a Vertical
  function bindChipsClick() {
    var wrap = document.getElementById('dcChips');
    if (!wrap) return;
    wrap.addEventListener('click', function(e){
      e.stopPropagation();
      var btn = e.target.closest('.dc-chip');
      if (!btn) return;
      var slug = btn.dataset.slug;
      var nome = btn.dataset.nome;
      caso.categoria = nome;
      caso.slug = slug;
      wrap.remove();
      addUserMsg(nome);

      var formData = CASE_FORMS[slug];
      fieldsQueue = formData ? formData.campos : [];
      fieldIdx = 0;

      setTimeout(function(){
        addBotMsg('<p>Entendido. Vamos verificar os critérios do TJSP e o lastro probatório para <b>' + nome + '</b>.</p>');
        setTimeout(processNextField, 350);
      }, 350);
    });
  }
  bindChipsClick();

  // Processamento Dinâmico dos Campos com Botões e Ícones
  function processNextField() {
    if (fieldIdx < fieldsQueue.length) {
      var f = fieldsQueue[fieldIdx];
      renderFieldStep(f);
    } else {
      askCity();
    }
  }

  function renderFieldStep(f) {
    var rotuloLimpo = limpaTexto(f.rotulo);

    // Caso 1: Pergunta sobre Empresa, Banco, Operadora ou Fornecedor (Ranking Real por Vertical)
    if (f.id === 'banco' || f.id === 'empresa' || f.id === 'operadora' || f.id === 'loja' || f.id === 'cia') {
      var configVertical = EMPRESAS_POR_VERTICAL[caso.slug];
      var perguntaHtml = configVertical ? configVertical.pergunta : '<p>Qual é <b>a empresa ou instituição</b> envolvida?</p>';
      var listaOpcoes = configVertical ? configVertical.opcoes : (f.opcoes && f.opcoes.length ? f.opcoes : BANCOS_SUGERIDOS);

      listaOpcoes = listaOpcoes.filter(function(opt){
        var o = opt.toLowerCase();
        return o !== 'outro' && o !== 'outra';
      });

      addBotMsg(perguntaHtml);
      renderButtonOptions(listaOpcoes, function(selectedVal){
        caso[f.id] = selectedVal;
        addUserMsg(selectedVal);
        fieldIdx++;
        setTimeout(processNextField, 350);
      }, '✏️ Digitar outro nome', f.id);
      return;
    }

    // Caso 2: Pergunta sobre Tipo de Serviço (Desvio Produtivo e SAC)
    if (f.id === 'servico') {
      addBotMsg('<p>Qual é o <b>tipo de serviço</b> que causou o desgaste no atendimento?</p>');
      renderButtonOptions(SERVICOS_SUGERIDOS, function(selectedVal){
        caso[f.id] = selectedVal;
        addUserMsg(selectedVal);
        fieldIdx++;
        setTimeout(processNextField, 350);
      }, '✏️ Digitar outro serviço', 'servico');
      return;
    }

    // Caso 3: Campo com opções predefinidas (Select)
    if (f.tipo === 'select' && f.opcoes && f.opcoes.length) {
      addBotMsg('<p>Selecione uma opção sobre <b>' + rotuloLimpo + '</b>:</p>');
      renderButtonOptions(f.opcoes, function(selectedVal){
        caso[f.id] = selectedVal;
        addUserMsg(selectedVal);
        fieldIdx++;
        setTimeout(processNextField, 350);
      }, '✏️ Outro detalhe', f.id);
      return;
    }

    // Caso 4: Pergunta sobre Valores Envolvidos
    if (f.tipo === 'money' || f.id === 'valor' || f.id === 'renda' || f.id === 'parcelas') {
      addBotMsg('<p>Qual é a <b>faixa de valor</b> envolvida?</p>');
      renderButtonOptions(VALORES_SUGERIDOS, function(selectedVal){
        caso[f.id] = selectedVal;
        addUserMsg(selectedVal);
        fieldIdx++;
        setTimeout(processNextField, 350);
      }, '✏️ Informar valor exato', 'valor');
      return;
    }

    // Caso 5: Campos de Data com opções imediatas de botões
    if (f.tipo === 'date' || f.tipo === 'month' || f.id === 'data' || f.id === 'desde') {
      addBotMsg('<p>Quando ocorreu o fato? Selecione o <b>período aproximado</b>:</p>');
      renderButtonOptions(DATAS_SUGERIDAS, function(selectedData){
        caso[f.id] = selectedData;
        addUserMsg(selectedData);
        fieldIdx++;
        setTimeout(processNextField, 350);
      }, '✏️ Informar data exata', 'data');
      return;
    }

    // Caso Geral: Texto simples
    addBotMsg('<p>Informe um detalhe sobre <b>' + rotuloLimpo + '</b>:</p>');
    renderHarmoniousInput(f.id, rotuloLimpo, 'text', f.placeholder || 'Informe este detalhe...');
  }

  // Renderizador de Botões Harmoniosos com Ícones SVG
  function renderButtonOptions(opcoesList, onSelectCallback, textoBotaoCustom, currentFieldId) {
    var container = document.createElement('div');
    container.className = 'dc-chips dc-field-chips';

    opcoesList.forEach(function(item){
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'dc-chip';
      var icName = resolveOptionIcon(item, currentFieldId);
      btn.innerHTML = makeSvg(icName, 15) + '<span>' + limpaTexto(item) + '</span>';
      container.appendChild(btn);

      btn.addEventListener('click', function(e){
        if (e) e.stopPropagation();
        container.remove();
        onSelectCallback(item);
      });
    });

    if (textoBotaoCustom) {
      var btnCustom = document.createElement('button');
      btnCustom.type = 'button';
      btnCustom.className = 'dc-chip dc-chip-write';
      btnCustom.innerHTML = makeSvg('pencil', 15) + '<span>' + textoBotaoCustom + '</span>';
      container.appendChild(btnCustom);

      btnCustom.addEventListener('click', function(e){
        if (e) e.stopPropagation();
        container.remove();
        var placeholderTxt = 'Digite aqui o detalhe desejado...';
        if (currentFieldId === 'empresa' || currentFieldId === 'banco' || currentFieldId === 'operadora' || currentFieldId === 'loja' || currentFieldId === 'cia') {
          placeholderTxt = 'Digite o nome da empresa ou instituição...';
        } else if (currentFieldId === 'servico') {
          placeholderTxt = 'Digite o tipo de serviço...';
        }
        renderHarmoniousInput('custom_val', 'Detalhe', 'text', placeholderTxt, function(digitado){
          onSelectCallback(digitado);
        });
      });
    }

    msgs.appendChild(container);
    scrollBottom();
  }

  // Campo de Entrada Harmonioso com Botão Estilizado de 6px e Ícone
  function renderHarmoniousInput(fieldId, rotulo, inputType, placeholder, customCallback) {
    var box = document.createElement('div');
    box.className = 'dc-input-line';

    var inp = document.createElement('input');
    inp.type = inputType;
    inp.placeholder = placeholder;
    inp.className = 'dc-text-input';

    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'dc-chip dc-chip-submit';
    btn.innerHTML = '<span>Confirmar</span>' + makeSvg('arrow', 13);

    box.appendChild(inp);
    box.appendChild(btn);
    msgs.appendChild(box);
    scrollBottom();
    inp.focus();

    function commit(e) {
      if (e) e.stopPropagation();
      var val = inp.value.trim();
      if (!val) {
        addBotMsg('<p>Por favor, informe este detalhe para continuarmos.</p>');
        inp.focus();
        return;
      }
      box.remove();
      if (customCallback) {
        customCallback(val);
      } else {
        caso[fieldId] = val;
        addUserMsg(val);
        fieldIdx++;
        setTimeout(processNextField, 350);
      }
    }

    btn.addEventListener('click', commit);
    inp.addEventListener('keydown', function(e){ if (e.key === 'Enter') commit(e); });
  }

  // Etapa: Cidade ou Comarca do Estado de SP com Campo Direto de Preenchimento
  function askCity() {
    addBotMsg('<p>Em qual <b>cidade ou comarca</b> do Estado de São Paulo você reside?</p>');

    var box = document.createElement('div');
    box.className = 'dc-input-line dc-input-line-col';

    // Atalho de 1 clique para São Paulo Capital
    var quickWrap = document.createElement('div');
    quickWrap.className = 'dc-chips';
    quickWrap.style.marginBottom = '6px';
    
    var btnSp = document.createElement('button');
    btnSp.type = 'button';
    btnSp.className = 'dc-chip';
    btnSp.innerHTML = makeSvg('pin', 15) + '<span>São Paulo Capital</span>';
    quickWrap.appendChild(btnSp);

    // Linha de digitação livre para qualquer município paulista
    var inputRow = document.createElement('div');
    inputRow.className = 'dc-input-line';
    inputRow.style.width = '100%';

    var inp = document.createElement('input');
    inp.type = 'text';
    inp.placeholder = 'Digite sua cidade. Ex.: Barueri, São Caetano, Campinas...';
    inp.className = 'dc-text-input';

    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'dc-chip dc-chip-submit';
    btn.innerHTML = '<span>Confirmar</span>' + makeSvg('arrow', 13);

    inputRow.appendChild(inp);
    inputRow.appendChild(btn);

    box.appendChild(quickWrap);
    box.appendChild(inputRow);
    msgs.appendChild(box);
    scrollBottom();
    inp.focus();

    function commitCity(city, e) {
      if (e) e.stopPropagation();
      var val = (city || inp.value).trim();
      if (!val) {
        addBotMsg('<p>Por favor, informe sua cidade para continuarmos.</p>');
        inp.focus();
        return;
      }
      box.remove();
      caso.cidade = val;
      addUserMsg(val);
      setTimeout(askFreeDetails, 350);
    }

    btnSp.addEventListener('click', function(e){ e.stopPropagation(); commitCity('São Paulo Capital', e); });
    btn.addEventListener('click', function(e){ e.stopPropagation(); commitCity(null, e); });
    inp.addEventListener('keydown', function(e){ if (e.key === 'Enter') commitCity(null, e); });
  }

  // Etapa: Detalhes Complementares com Botões Didáticos
  function askFreeDetails() {
    addBotMsg('<p>Deseja acrescentar algum detalhe específico com suas próprias palavras?</p>');

    var chips = document.createElement('div');
    chips.className = 'dc-chips dc-field-chips';

    var btnNao = document.createElement('button');
    btnNao.type = 'button';
    btnNao.className = 'dc-chip';
    btnNao.innerHTML = makeSvg('check', 15) + '<span>Não, as opções acima já cobrem meu caso</span>';

    var btnSim = document.createElement('button');
    btnSim.type = 'button';
    btnSim.className = 'dc-chip dc-chip-write';
    btnSim.innerHTML = makeSvg('pencil', 15) + '<span>✏️ Sim, quero acrescentar um breve texto</span>';

    chips.appendChild(btnNao);
    chips.appendChild(btnSim);
    msgs.appendChild(chips);
    scrollBottom();

    btnNao.addEventListener('click', function(e){
      if (e) e.stopPropagation();
      chips.remove();
      caso.descricao = 'Caso estruturado via triagem indutiva de perguntas objetivas.';
      addUserMsg('Sem acréscimos adicionais');
      setTimeout(askContact, 350);
    });

    btnSim.addEventListener('click', function(e){
      if (e) e.stopPropagation();
      chips.remove();
      var box = document.createElement('div');
      box.className = 'dc-input-line dc-input-line-col';
      box.innerHTML = 
        '<textarea id="dcDescText" rows="3" class="dc-textarea" placeholder="Descreva sucintamente outros pontos relevantes..."></textarea>' +
        '<button type="button" id="dcSaveDesc" class="dc-chip dc-chip-submit" style="align-self:flex-end; margin-top:6px;"><span>Avançar</span>' + makeSvg('arrow', 13) + '</button>';
      msgs.appendChild(box);
      scrollBottom();
      document.getElementById('dcDescText').focus();

      document.getElementById('dcSaveDesc').addEventListener('click', function(ev){
        if (ev) ev.stopPropagation();
        var val = document.getElementById('dcDescText').value.trim();
        caso.descricao = val || 'Relato estruturado via triagem indutiva.';
        box.remove();
        if (val) addUserMsg(val);
        setTimeout(askContact, 350);
      });
    });
  }

  // Etapa Final: Identificação para Retorno com Aviso Didático
  function askContact() {
    addBotMsg('<p>Excelente. Para onde devemos enviar o relatório didático de jurimetria do TJSP e a relação de provas? Informe seus dados para retorno:</p>');

    var formBox = document.createElement('div');
    formBox.className = 'dc-input-line dc-input-line-col dc-card-contact';
    formBox.innerHTML = 
      '<div class="dc-legal-badge">' +
        makeSvg('shield', 13) +
        '<span>Pesquisa Didática · Sem Vínculo Advocatício</span>' +
      '</div>' +
      '<label class="dc-field"><span>Seu nome completo <i>*</i></span><input type="text" id="dcNome" class="dc-text-input" placeholder="Seu nome" required /></label>' +
      '<label class="dc-field"><span>WhatsApp com DDD <i>*</i></span><input type="tel" id="dcWhats" class="dc-text-input" placeholder="DDD + número" required /></label>' +
      '<label class="dc-field"><span>E-mail opcional</span><input type="email" id="dcEmail" class="dc-text-input" placeholder="seu@email.com" /></label>' +
      '<label class="dc-ok"><input type="checkbox" id="dcLgpd" checked /><span>Declaro ciência de que esta pesquisa jurimétrica é puramente didática e informativa, não substituindo consulta com advogado nem constituindo contratação de serviços de advocacia.</span></label>' +
      '<button type="button" id="dcSubmit" class="dc-send-btn">' +
        makeSvg('send', 15) +
        '<span>Receber Pesquisa Jurimétrica Didática</span>' +
      '</button>';
    msgs.appendChild(formBox);
    scrollBottom();

    document.getElementById('dcSubmit').addEventListener('click', function(e){
      if (e) e.stopPropagation();
      var nome = document.getElementById('dcNome').value.trim();
      var whats = document.getElementById('dcWhats').value.trim();
      var email = document.getElementById('dcEmail').value.trim();
      var lgpd = document.getElementById('dcLgpd').checked;

      if (!nome) { addBotMsg('<p>Informe seu nome completo para finalizar.</p>'); document.getElementById('dcNome').focus(); return; }
      if (!whats || whats.replace(/\D/g, '').length < 10) { addBotMsg('<p>Informe um WhatsApp válido com DDD (ex.: 11 99999-9999).</p>'); document.getElementById('dcWhats').focus(); return; }
      if (!lgpd) { addBotMsg('<p>Marque a declaração de ciência antes de prosseguir.</p>'); return; }

      var proto = 'DM-' + new Date().toISOString().slice(2,10).replace(/-/g,'') + '-' + Math.random().toString(36).slice(2,6).toUpperCase();
      caso.nome = nome;
      caso.whatsapp = whats;
      caso.email = email;
      caso.protocolo = proto;
      caso.pagina = location.pathname;

      formBox.remove();
      addUserMsg(nome + ' · ' + whats);

      addBotMsg('<p>⏳ <i>Processando indicadores de jurimetria do TJSP...</i></p>');

      var finalized = false;
      function done() {
        if (finalized) return;
        finalized = true;
        finalizarSucesso(proto);
      }

      // Envio assíncrono em segundo plano para o Google Sheets (sem travar a experiência do usuário)
      var targetEndpoint = endpoint || 'https://script.google.com/macros/s/AKfycbw5Ecm-R6v8GKfF_EQAAwka_EsQaD6FTMGerkNLdwlc8Ll3yGYpaasjjHkDRvi29jkVyg/exec';
      try {
        fetch(targetEndpoint, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(caso)
        })
        .then(function(){ done(); })
        .catch(function(){ done(); });
      } catch(e) {
        done();
      }

      // Trava de segurança: garante a entrega do protocolo em no máximo 1200ms
      setTimeout(done, 1200);
    });
  }

  function finalizarSucesso(proto) {
    isFinished = true;
    var msgWhats = 'Olá André Silva, acabei de registrar a pesquisa no portal DefendaMe sob o protocolo ' + proto + ' sobre ' + (caso.categoria || 'minha demanda') + ' e gostaria de receber o relatório didático de jurimetria do TJSP.';
    var linkWhats = 'https://api.whatsapp.com/send?phone=' + whatsNumber + '&text=' + encodeURIComponent(msgWhats);

    var html = '';

    if (isComercial) {
      // Cenário 1: Horário Comercial (Seg-Sex das 09h às 18h) -> Atendimento Imediato no WhatsApp
      html = 
        '<div class="dc-success">' +
          '<div class="dc-success-badge dc-badge-online">● Atendimento Comercial Ativo</div>' +
          '<p>✅ <b>Pesquisa Jurimétrica Registrada!</b></p>' +
          '<p class="dc-proto-badge">Protocolo: <b>' + proto + '</b></p>' +
          '<p>Seus dados foram consolidados no motor de jurimetria. Nossa equipe técnica está ativa para retorno imediato do diagnóstico e da relação probatória.</p>' +
          '<p class="dc-notice-legal" style="margin-top:8px; font-size:11px; color:#667085; line-height:1.35;">Lembramos que este relatório tem caráter didático e informativo, não configurando prestação de serviços advocatícios. Havendo demanda contenciosa, consulte um advogado especializado.</p>' +
          '<div class="dc-done-actions" style="margin-top:10px;">' +
            '<a href="' + linkWhats + '" target="_blank" rel="noopener" class="btn btn-whatsapp dc-wbtn">' +
              makeSvg('whatsapp', 16) +
              '<span>Receber no WhatsApp</span>' +
            '</a>' +
            '<button type="button" class="dc-chip dc-chip-copy" data-proto="' + proto + '" style="width:100%; justify-content:center; margin-top:8px;">' +
              makeSvg('doc', 14) +
              '<span>Copiar Protocolo</span>' +
            '</button>' +
          '</div>' +
        '</div>';
    } else {
      // Cenário 2: Fora do Expediente (Noites, Finais de Semana e Feriados) -> Tela Técnica de Confirmação e Plantão
      html = 
        '<div class="dc-success dc-success-offline">' +
          '<div class="dc-success-badge dc-badge-plantao">⏳ Plantão Assíncrono · Fila de Triagem</div>' +
          '<p>✅ <b>Solicitação Recebida com Sucesso!</b></p>' +
          '<p class="dc-proto-badge">Protocolo: <b>' + proto + '</b></p>' +
          '<div class="dc-offline-box">' +
            '<p>Seu caso foi protocolado com sucesso na nossa base de jurimetria do TJSP.</p>' +
            '<p style="margin-top:6px;">Como o envio ocorreu fora do expediente comercial, os dados estão em processamento analítico prioritário. Nossa equipe técnica encaminhará o levantamento de precedentes e o checklist probatório diretamente no seu WhatsApp no início do próximo expediente útil a partir das 09h00.</p>' +
          '</div>' +
          '<p class="dc-notice-legal" style="margin-top:8px; font-size:11px; color:#667085; line-height:1.35;">Lembramos que este relatório tem caráter didático e informativo, não configurando prestação de serviços advocatícios. Havendo demanda contenciosa, consulte um advogado especializado.</p>' +
          '<div class="dc-done-actions dc-actions-split" style="margin-top:12px; display:flex; gap:8px;">' +
            '<button type="button" class="dc-chip dc-chip-copy" data-proto="' + proto + '" style="flex:1; justify-content:center;">' +
              makeSvg('doc', 14) +
              '<span>Copiar Protocolo</span>' +
            '</button>' +
            '<button type="button" class="dc-chip dc-chip-close" style="flex:1; justify-content:center;">' +
              '<span>Concluir</span>' +
            '</button>' +
          '</div>' +
        '</div>';
    }

    // Remove qualquer mensagem anterior de aguardo/carregamento
    var botMsgs = msgs.querySelectorAll('.dc-msg-bot');
    for (var i = 0; i < botMsgs.length; i++) {
      var t = botMsgs[i].textContent;
      if (t.indexOf('Processando') !== -1 || t.indexOf('Enviando relato') !== -1 || t.indexOf('Registrando') !== -1) {
        botMsgs[i].remove();
      }
    }

    addBotMsg(html);

    // Eventos de Copiar Protocolo e Concluir
    var copyBtn = msgs.querySelector('.dc-chip-copy[data-proto="' + proto + '"]');
    if (copyBtn) {
      copyBtn.addEventListener('click', function(e){
        if (e) e.stopPropagation();
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(proto);
        }
        var span = copyBtn.querySelector('span');
        if (span) span.textContent = 'Protocolo Copiado!';
        copyBtn.style.borderColor = 'var(--dc-teal)';
        copyBtn.style.color = 'var(--dc-teal)';
      });
    }

    var finishBtn = msgs.querySelector('.dc-chip-close');
    if (finishBtn) {
      finishBtn.addEventListener('click', function(e){
        if (e) e.stopPropagation();
        closeChat();
      });
    }
  }
})();
</script>

<style is:global>
  /* 
   * Paleta Clara FIXA e Isolação Completa para #defendaChat
   * Imune a qualquer modo dark do sistema ou site
   */
  #defendaChat {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 950;
    width: 390px;
    max-width: calc(100vw - 32px);
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
    font-family: inherit;
    color-scheme: light !important;
    --dc-bg: #F6FBFA;
    --dc-surface: #FFFFFF;
    --dc-border: #E3E8EC;
    --dc-line-teal: #CFE7E3;
    --dc-teal: #12857E;
    --dc-teal-h: #0F736D;
    --dc-teal-pale: #E6F4F2;
    --dc-navy: #1D2939;
    --dc-fg: #1D2939;
    --dc-fg-mid: #3B475A;
    --dc-fg-muted: #667085;
  }

  /* Janela do Chat: quina de 8px e fundo surface fixo claro */
  #defendaChat .dc-window[hidden] {
    display: none !important;
  }
  #defendaChat .dc-window {
    pointer-events: auto;
    position: relative;
    width: 100%;
    height: 520px;
    max-height: calc(100vh - 100px);
    margin-bottom: 12px;
