---
/**
 * Assistente Conversacional de Triagem Informativa do DefendaMe.
 * Conexão direta com Google Sheets + Gemini AI + WhatsApp 1-Clique.
 * Em estrita conformidade com o Provimento CFOAB nº 205/2021 (caráter educativo e informativo).
 * Interface 100% harmoniosa baseada em botões e quinas de 6px (sem blocos cinzas genéricos).
 */
import Icon from './Icon.astro';
import { AUTHOR, SITE } from '../data/site';
import { TEMAS } from '../data/temas';
import { CASE_FORMS } from '../data/caseForms';

const endpoint = SITE.formEndpoint;
const caseFormsJson = JSON.stringify(CASE_FORMS);
---

<div id="defendaChat" class="dc-root" aria-live="polite">
  <!-- Botão Flutuante (Launcher padrão com quinas de 6px) -->
  <button type="button" id="dcToggle" class="dc-launcher" aria-label="Abrir triagem informativa online" aria-expanded="false">
    <div class="dc-launcher-avatar">
      <img src={AUTHOR.photo} alt={AUTHOR.name} width="40" height="40" loading="lazy" />
      <span class="dc-status-dot" id="dcDot"></span>
    </div>
    <div class="dc-launcher-label">
      <span class="dc-lbl-top">Dúvidas no JEC?</span>
      <span class="dc-lbl-sub" id="dcStatusShort">Triagem informativa</span>
    </div>
  </button>

  <!-- Janela do Chat -->
  <div id="dcWindow" class="dc-window" hidden role="dialog" aria-modal="true" aria-labelledby="dcHeaderTitle">
    <!-- Cabeçalho -->
    <div class="dc-header">
      <div class="dc-header-info">
        <div class="dc-header-avatar">
          <img src={AUTHOR.photo} alt={AUTHOR.name} width="38" height="38" />
          <span class="dc-status-dot-sm" id="dcHeaderDot"></span>
        </div>
        <div>
          <h3 id="dcHeaderTitle" class="dc-name">{AUTHOR.name}</h3>
          <p class="dc-role" id="dcHeaderStatus">Triagem Informativa · Lei 9.099/1995</p>
        </div>
      </div>
      <button type="button" id="dcClose" class="dc-close-btn" aria-label="Fechar triagem">
        <Icon name="x" size={18} stroke={2.2} />
      </button>
    </div>

    <!-- Barra de Aviso de Horário e Finalidade -->
    <div class="dc-notice" id="dcNoticeBar">
      <span id="dcNoticeText">Atendimento informativo: Segunda a Sexta, das 9h às 18h.</span>
    </div>

    <!-- Área de Mensagens da Conversa -->
    <div class="dc-messages" id="dcMessages">
      <!-- Mensagens Iniciais do Bot -->
      <div class="dc-msg dc-msg-bot">
        <p>Olá! Sou o assistente de triagem informativa do DefendaMe.</p>
      </div>
      <div class="dc-msg dc-msg-bot">
        <p>Orientamos o cidadão sobre os requisitos da Lei 9.099 de 1995 e a jurimetria do TJSP para o exercício da atermação direta. Qual situação você deseja verificar?</p>
      </div>

      <!-- Grade de Botões Iniciais das 14 Verticais -->
      <div class="dc-chips" id="dcChips">
        {TEMAS.map((t) => (
          <button type="button" class="dc-chip" data-slug={t.slug} data-nome={t.nome}>
            <Icon name={t.icone} size={15} />
            <span>{t.curto}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Rodapé em Conformidade Rigorosa com a OAB -->
    <div class="dc-footer">
      <small>Conteúdo educativo em conformidade com o Provimento CFOAB nº 205/2021. Sem promessa de resultado.</small>
    </div>
  </div>
</div>

<script type="application/json" id="dcFormsData" set:html={caseFormsJson} />

<script is:inline define:vars={{ endpoint, whatsNumber: '5511966016189' }}>
(function(){
  var root = document.getElementById('defendaChat');
  if (!root) return;

  var formsEl = document.getElementById('dcFormsData');
  var CASE_FORMS = formsEl ? JSON.parse(formsEl.textContent) : {};

  var toggleBtn = document.getElementById('dcToggle');
  var win = document.getElementById('dcWindow');
  var closeBtn = document.getElementById('dcClose');
  var msgs = document.getElementById('dcMessages');
  var chipsWrap = document.getElementById('dcChips');
  var dot = document.getElementById('dcDot');
  var headerDot = document.getElementById('dcHeaderDot');
  var headerStatus = document.getElementById('dcHeaderStatus');
  var statusShort = document.getElementById('dcStatusShort');
  var noticeBar = document.getElementById('dcNoticeBar');
  var noticeText = document.getElementById('dcNoticeText');

  // Checagem de Horário Comercial
  var now = new Date();
  var day = now.getDay();
  var hour = now.getHours();
  var isComercial = (day >= 1 && day <= 5 && hour >= 9 && hour < 18);

  if (isComercial) {
    dot.classList.add('online');
    headerDot.classList.add('online');
    statusShort.textContent = 'Plantão ativo';
    headerStatus.textContent = 'Triagem Informativa · Horário Comercial';
    noticeBar.classList.add('is-open');
    noticeText.textContent = 'Horário Comercial ativo. Retorno informativo por WhatsApp.';
  } else {
    dot.classList.add('plantao');
    headerDot.classList.add('plantao');
    statusShort.textContent = 'Plantão de Triagem';
    headerStatus.textContent = 'Plantão · Retorno no 1º horário útil';
    noticeBar.classList.add('is-plantao');
    noticeText.textContent = 'Plantão de Triagem. Demandas enviadas agora serão analisadas no primeiro horário útil seguinte.';
  }

  function openChat() {
    win.hidden = false;
    toggleBtn.setAttribute('aria-expanded', 'true');
    toggleBtn.classList.add('active');
    scrollBottom();
  }

  function closeChat() {
    win.hidden = true;
    toggleBtn.setAttribute('aria-expanded', 'false');
    toggleBtn.classList.remove('active');
  }

  toggleBtn.addEventListener('click', function(){
    if (win.hidden) openChat(); else closeChat();
  });

  closeBtn.addEventListener('click', closeChat);

  function scrollBottom() {
    setTimeout(function(){ msgs.scrollTop = msgs.scrollHeight; }, 35);
  }

  function addBotMsg(html) {
    var div = document.createElement('div');
    div.className = 'dc-msg dc-msg-bot';
    div.innerHTML = html;
    msgs.appendChild(div);
    scrollBottom();
  }

  function addUserMsg(text) {
    var div = document.createElement('div');
    div.className = 'dc-msg dc-msg-user';
    div.textContent = text;
    msgs.appendChild(div);
    scrollBottom();
  }

  // Remove qualquer parênteses de rótulos
  function limpaTexto(str) {
    if (!str) return '';
    return str.replace(/\s*\([^)]*\)/g, '').trim();
  }

  // Sugestões de Botões Harmoniosos para campos de texto frequentes
  var BANCOS_SUGERIDOS = ['Nubank', 'Itaú', 'Bradesco', 'Santander', 'Banco C6', 'Caixa', 'Banco Inter'];
  var CIAS_SUGERIDAS = ['LATAM', 'GOL', 'Azul', 'Passaredo'];
  var CONCESSOES_SUGERIDAS = ['Enel SP', 'CPFL', 'Sabesp', 'Comgás', 'Claro', 'Vivo', 'TIM'];
  var CIDADES_SUGERIDAS = ['São Paulo Capital', 'Barueri ou Alphaville', 'Osasco e Região', 'Guarulhos', 'Campinas e Interior', 'Grande ABC', 'Baixada Santista'];
  var VALORES_SUGERIDOS = ['Até R$ 1.000', 'De R$ 1.000 a R$ 5.000', 'De R$ 5.000 a R$ 15.000', 'Acima de R$ 15.000'];

  // Estado da Sessão
  var caso = {
    origem: 'Chat Online',
    categoria: '',
    slug: '',
    protocolo: ''
  };

  var fieldsQueue = [];
  var fieldIdx = 0;

  // Etapa 1: Usuário escolhe a Vertical
  if (chipsWrap) {
    chipsWrap.addEventListener('click', function(e){
      var btn = e.target.closest('.dc-chip');
      if (!btn) return;
      var slug = btn.dataset.slug;
      var nome = btn.dataset.nome;
      caso.categoria = nome;
      caso.slug = slug;
      chipsWrap.remove();
      addUserMsg(nome);

      var formData = CASE_FORMS[slug];
      fieldsQueue = formData ? formData.campos : [];
      fieldIdx = 0;

      setTimeout(function(){
        addBotMsg('<p>Entendido. Vamos verificar os critérios do TJSP e o lastro probatório para <b>' + nome + '</b>.</p>');
        setTimeout(processNextField, 350);
      }, 350);
    });
  }

  // Processamento Dinâmico dos Campos
  function processNextField() {
    if (fieldIdx < fieldsQueue.length) {
      var f = fieldsQueue[fieldIdx];
      renderFieldStep(f);
    } else {
      askCity();
    }
  }

  function renderFieldStep(f) {
    var rotuloLimpo = limpaTexto(f.rotulo);

    // Caso 1: Campo com opções predefinidas (Select)
    if (f.tipo === 'select' && f.opcoes && f.opcoes.length) {
      addBotMsg('<p><b>' + rotuloLimpo + '</b></p>');
      renderButtonOptions(f.opcoes, function(selectedVal){
        caso[f.id] = selectedVal;
        addUserMsg(selectedVal);
        fieldIdx++;
        setTimeout(processNextField, 350);
      }, '✏️ Outro detalhe');
      return;
    }

    // Caso 2: Pergunta sobre Banco ou Empresa Envolvida
    if (f.id === 'banco' || f.id === 'empresa' || f.id === 'operadora' || f.id === 'loja') {
      addBotMsg('<p><b>' + rotuloLimpo + '</b></p>');
      var sugestoes = BANCOS_SUGERIDOS;
      if (caso.slug === 'transporte-aereo' || caso.slug === 'bagagem') sugestoes = CIAS_SUGERIDAS;
      else if (caso.slug === 'energia-eletrica' || caso.slug === 'telefonia') sugestoes = CONCESSOES_SUGERIDAS;

      renderButtonOptions(sugestoes, function(selectedVal){
        caso[f.id] = selectedVal;
        addUserMsg(selectedVal);
        fieldIdx++;
        setTimeout(processNextField, 350);
      }, '✏️ Digitar outro nome');
      return;
    }

    // Caso 3: Pergunta sobre Valores Envolvidos
    if (f.tipo === 'money' || f.id === 'valor') {
      addBotMsg('<p><b>' + rotuloLimpo + '</b></p>');
      renderButtonOptions(VALORES_SUGERIDOS, function(selectedVal){
        caso[f.id] = selectedVal;
        addUserMsg(selectedVal);
        fieldIdx++;
        setTimeout(processNextField, 350);
      }, '✏️ Informar valor exato');
      return;
    }

    // Caso 4: Campos de Data
    if (f.tipo === 'date' || f.tipo === 'month') {
      addBotMsg('<p><b>' + rotuloLimpo + '</b></p>');
      renderHarmoniousInput(f.id, rotuloLimpo, f.tipo, 'Selecione a data');
      return;
    }

    // Caso Geral: Texto simples
    addBotMsg('<p><b>' + rotuloLimpo + '</b></p>');
    renderHarmoniousInput(f.id, rotuloLimpo, 'text', f.placeholder || 'Informe este detalhe...');
  }

  // Renderizador de Botões Harmoniosos
  function renderButtonOptions(opcoesList, onSelectCallback, textoBotaoCustom) {
    var container = document.createElement('div');
    container.className = 'dc-chips dc-field-chips';

    opcoesList.forEach(function(item){
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'dc-chip';
      btn.textContent = limpaTexto(item);
      container.appendChild(btn);

      btn.addEventListener('click', function(){
        container.remove();
        onSelectCallback(item);
      });
    });

    if (textoBotaoCustom) {
      var btnCustom = document.createElement('button');
      btnCustom.type = 'button';
      btnCustom.className = 'dc-chip dc-chip-write';
      btnCustom.textContent = textoBotaoCustom;
      container.appendChild(btnCustom);

      btnCustom.addEventListener('click', function(){
        container.remove();
        renderHarmoniousInput('custom_val', 'Detalhe', 'text', 'Digite aqui o detalhe desejado...', function(digitado){
          onSelectCallback(digitado);
        });
      });
    }

    msgs.appendChild(container);
    scrollBottom();
  }

  // Campo de Entrada Harmonioso (Discreto e Alinhado)
  function renderHarmoniousInput(fieldId, rotulo, inputType, placeholder, customCallback) {
    var box = document.createElement('div');
    box.className = 'dc-input-line';

    var inp = document.createElement('input');
    inp.type = inputType;
    inp.placeholder = placeholder;
    inp.className = 'dc-text-input';

    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'btn btn-primary dc-inline-btn';
    btn.textContent = 'OK';

    box.appendChild(inp);
    box.appendChild(btn);
    msgs.appendChild(box);
    scrollBottom();
    inp.focus();

    function commit() {
      var val = inp.value.trim();
      if (!val) {
        alert('Por favor, informe este detalhe para continuarmos.');
        return;
      }
      box.remove();
      if (customCallback) {
        customCallback(val);
      } else {
        caso[fieldId] = val;
        addUserMsg(val);
        fieldIdx++;
        setTimeout(processNextField, 350);
      }
    }

    btn.addEventListener('click', commit);
    inp.addEventListener('keydown', function(e){ if (e.key === 'Enter') commit(); });
  }

  // Etapa: Cidade do Estado de SP
  function askCity() {
    addBotMsg('<p><b>Em qual comarca ou região do Estado de São Paulo você mora?</b></p>');
    renderButtonOptions(CIDADES_SUGERIDAS, function(cidadeEscolhida){
      caso.cidade = cidadeEscolhida;
      addUserMsg(cidadeEscolhida);
      setTimeout(askFreeDetails, 350);
    }, '✏️ Outra comarca paulista');
  }

  // Etapa: Detalhes Complementares (Com botões)
  function askFreeDetails() {
    addBotMsg('<p><b>Deseja acrescentar algum detalhe específico com suas próprias palavras?</b></p>');

    var chips = document.createElement('div');
    chips.className = 'dc-chips dc-field-chips';

    var btnNao = document.createElement('button');
    btnNao.type = 'button';
    btnNao.className = 'dc-chip';
    btnNao.textContent = 'Não, as opções acima já cobrem meu caso';

    var btnSim = document.createElement('button');
    btnSim.type = 'button';
    btnSim.className = 'dc-chip dc-chip-write';
    btnSim.textContent = '✏️ Sim, quero acrescentar um breve texto';

    chips.appendChild(btnNao);
    chips.appendChild(btnSim);
    msgs.appendChild(chips);
    scrollBottom();

    btnNao.addEventListener('click', function(){
      chips.remove();
      caso.descricao = 'Caso estruturado via triagem indutiva de perguntas objetivas.';
      addUserMsg('Sem acréscimos adicionais');
      setTimeout(askContact, 350);
    });

    btnSim.addEventListener('click', function(){
      chips.remove();
      var box = document.createElement('div');
      box.className = 'dc-input-line dc-input-line-col';
      box.innerHTML = 
        '<textarea id="dcDescText" rows="3" class="dc-textarea" placeholder="Descreva sucintamente outros pontos relevantes..."></textarea>' +
        '<button type="button" id="dcSaveDesc" class="btn btn-primary dc-inline-btn">Avançar</button>';
      msgs.appendChild(box);
      scrollBottom();
      document.getElementById('dcDescText').focus();

      document.getElementById('dcSaveDesc').addEventListener('click', function(){
        var val = document.getElementById('dcDescText').value.trim();
        caso.descricao = val || 'Relato estruturado via triagem indutiva.';
        box.remove();
        if (val) addUserMsg(val);
        setTimeout(askContact, 350);
      });
    });
  }

  // Etapa Final: Identificação para Retorno da Análise
  function askContact() {
    addBotMsg('<p>Excelente. Para onde devemos enviar o diagnóstico preliminar do TJSP e a relação de provas necessárias? Informe seus dados para retorno:</p>');

    var formBox = document.createElement('div');
    formBox.className = 'dc-input-line dc-input-line-col dc-card-contact';
    formBox.innerHTML = 
      '<label class="dc-field"><span>Seu nome completo <i>*</i></span><input type="text" id="dcNome" class="dc-text-input" placeholder="Seu nome" required /></label>' +
      '<label class="dc-field"><span>WhatsApp com DDD <i>*</i></span><input type="tel" id="dcWhats" class="dc-text-input" placeholder="DDD + número" required /></label>' +
      '<label class="dc-field"><span>E-mail opcional</span><input type="email" id="dcEmail" class="dc-text-input" placeholder="seu@email.com" /></label>' +
      '<label class="dc-ok"><input type="checkbox" id="dcLgpd" checked /><span>Autorizo o envio das orientações nos termos da LGPD e do Provimento CFOAB nº 205/2021.</span></label>' +
      '<button type="button" id="dcSubmit" class="btn btn-primary dc-send-btn">Receber Análise Informativa Gratuita</button>';
    msgs.appendChild(formBox);
    scrollBottom();

    document.getElementById('dcSubmit').addEventListener('click', function(){
      var nome = document.getElementById('dcNome').value.trim();
      var whats = document.getElementById('dcWhats').value.trim();
      var email = document.getElementById('dcEmail').value.trim();
      var lgpd = document.getElementById('dcLgpd').checked;

      if (!nome) { alert('Informe seu nome completo.'); return; }
      if (!whats || whats.replace(/\D/g, '').length < 10) { alert('Informe um WhatsApp válido com DDD.'); return; }
      if (!lgpd) { alert('Você precisa concordar com os termos informativos.'); return; }

      var proto = 'DM-' + new Date().toISOString().slice(2,10).replace(/-/g,'') + '-' + Math.random().toString(36).slice(2,6).toUpperCase();
      caso.nome = nome;
      caso.whatsapp = whats;
      caso.email = email;
      caso.protocolo = proto;
      caso.pagina = location.pathname;

      formBox.remove();
      addUserMsg(nome + ' · ' + whats);

      addBotMsg('<p>⏳ <i>Enviando relato para análise da jurimetria...</i></p>');

      this.disabled = true;

      fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(caso)
      })
      .then(function(){ finalizarSucesso(proto); })
      .catch(function(){ finalizarSucesso(proto); });
    });
  }

  function finalizarSucesso(proto) {
    var txtHorario = isComercial 
      ? 'Como estamos em <b>horário comercial</b>, o diagnóstico preliminar e a relação probatória serão enviados para o seu WhatsApp em breve.'
      : 'Como você enviou fora do horário de expediente comercial, o seu protocolo está registrado no <b>Plantão de Triagem</b> e será respondido no primeiro horário útil seguinte.';

    var msgWhats = 'Olá André Silva, acabei de enviar meu relato pelo Chat do portal DefendaMe sob o protocolo ' + proto + ' sobre ' + caso.categoria + ' e gostaria de receber a análise informativa.';
    var linkWhats = 'https://api.whatsapp.com/send?phone=' + whatsNumber + '&text=' + encodeURIComponent(msgWhats);

    var html = 
      '<div class="dc-success">' +
        '<p>✅ <b>Triagem registrada com sucesso!</b></p>' +
        '<p class="dc-proto-badge">Protocolo: <b>' + proto + '</b></p>' +
        '<p>' + txtHorario + '</p>' +
        '<div class="dc-done-actions">' +
          '<a href="' + linkWhats + '" target="_blank" rel="noopener" class="btn btn-whatsapp dc-wbtn">' +
            '💬 Iniciar conversa no WhatsApp agora' +
          '</a>' +
        '</div>' +
      '</div>';

    var lastMsg = msgs.querySelector('.dc-msg-bot:last-child');
    if (lastMsg && lastMsg.textContent.indexOf('Enviando relato') !== -1) {
      lastMsg.remove();
    }

    addBotMsg(html);
  }
})();
</script>

<style>
  .dc-root {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 950;
    font-family: inherit;
  }

  /* Launcher Flutuante: Padrão DefendaMe quadrado com quina quebrada (6px) */
  .dc-launcher {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--navy);
    border: 1px solid var(--border);
    padding: 6px 14px 6px 6px;
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    color: var(--fg);
  }
  .dc-launcher:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.36);
    border-color: var(--teal);
  }
  .dc-launcher.active {
    opacity: 0.88;
    transform: scale(0.98);
  }

  .dc-launcher-avatar {
    position: relative;
    width: 40px;
    height: 40px;
    border-radius: 4px;
    overflow: visible;
  }
  .dc-launcher-avatar img {
    width: 40px;
    height: 40px;
    border-radius: 4px;
    object-fit: cover;
    display: block;
    border: 1.5px solid var(--teal);
  }

  .dc-status-dot {
    position: absolute;
    bottom: -2px;
    right: -2px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1.5px solid var(--navy);
  }
  .dc-status-dot.online {
    background: #10B981;
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.3);
  }
  .dc-status-dot.plantao {
    background: #F59E0B;
    box-shadow: 0 0 0 2px rgba(245, 158, 11, 0.3);
  }

  .dc-launcher-label {
    display: flex;
    flex-direction: column;
    text-align: left;
  }
  .dc-lbl-top {
    font-size: 13px;
    font-weight: 600;
    color: #FFFFFF;
    line-height: 1.2;
  }
  .dc-lbl-sub {
    font-size: 11px;
    color: var(--teal);
    line-height: 1.2;
  }

  /* Janela do Chat: quina de 8px */
  .dc-window {
    position: absolute;
    bottom: 64px;
    right: 0;
    width: 390px;
    max-width: calc(100vw - 32px);
    height: 540px;
    max-height: calc(100vh - 90px);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: dcFadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes dcFadeIn {
    from { opacity: 0; transform: translateY(10px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* Header do Chat */
  .dc-header {
    background: var(--navy);
    padding: 12px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
  }
  .dc-header-info {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .dc-header-avatar {
    position: relative;
    width: 36px;
    height: 36px;
  }
  .dc-header-avatar img {
    width: 36px;
    height: 36px;
    border-radius: 4px;
    object-fit: cover;
    border: 1.5px solid var(--teal);
  }
  .dc-status-dot-sm {
    position: absolute;
    bottom: -1px;
    right: -1px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.5px solid var(--navy);
  }
  .dc-status-dot-sm.online { background: #10B981; }
  .dc-status-dot-sm.plantao { background: #F59E0B; }

  .dc-name {
    font-size: 14.5px;
    font-weight: 600;
    color: #FFFFFF;
    margin: 0;
    line-height: 1.2;
  }
  .dc-role {
    font-size: 11px;
    color: var(--teal);
    margin: 0;
    line-height: 1.2;
  }
  .dc-close-btn {
    background: transparent;
    border: none;
    color: var(--fg-muted);
    cursor: pointer;
    padding: 6px;
    display: flex;
