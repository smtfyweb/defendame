---
/**
 * Assistente Conversacional de Pesquisa Jurimétrica do DefendaMe.
 * Conexão direta com Google Sheets + Gemini AI + WhatsApp 1-Clique.
 * Em estrita conformidade com o Provimento CFOAB nº 205/2021.
 * 
 * Atualizações de Design e Comportamento:
 * 1. Paleta clara fixa e imune a temas dark (#FFFFFF, #1D2939, #12857E).
 * 2. Header limpo com Logo centralizada e Slogan Técnico curto e objetivo (bloco de 6 linhas excluído).
 * 3. Comportamento inteligente de expansão e retração (inicia fechado, fecha ao clicar fora, Esc ou 35s inativo).
 * 4. Estilos globais isolados em #defendaChat para estilizar 100% dos botões dinâmicos em todas as etapas.
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE } from '../data/site';
import { TEMAS } from '../data/temas';
import { CASE_FORMS } from '../data/caseForms';

const endpoint = SITE.formEndpoint;
const caseFormsJson = JSON.stringify(CASE_FORMS);
---

<div id="defendaChat" class="dc-root" aria-live="polite">
  <!-- Janela do Chat (acima do botão) -->
  <div id="dcWindow" class="dc-window" hidden role="dialog" aria-modal="true" aria-labelledby="dcHeaderSlogan">
    <!-- Cabeçalho com Logo Centralizada e Slogan Técnico Limpo -->
    <div class="dc-header">
      <button type="button" id="dcReset" class="dc-header-btn dc-reset-btn" aria-label="Reiniciar pesquisa" title="Reiniciar pesquisa">
        <Icon name="rotate-ccw" size={16} stroke={2.2} />
      </button>
      <div class="dc-header-center">
        <Logo href="javascript:void(0)" class="dc-header-logo" />
        <span class="dc-header-slogan" id="dcHeaderSlogan">Jurimetria Forense e Análise do TJSP</span>
      </div>
      <button type="button" id="dcClose" class="dc-header-btn dc-close-btn" aria-label="Fechar pesquisa" title="Fechar pesquisa">
        <Icon name="x" size={18} stroke={2.2} />
      </button>
    </div>

    <!-- Área de Mensagens da Conversa -->
    <div class="dc-messages" id="dcMessages">
      <!-- Mensagens Iniciais do Bot -->
      <div class="dc-msg dc-msg-bot">
        <p>Olá! Sou o assistente de pesquisa jurimétrica do DefendaMe.</p>
      </div>
      <div class="dc-msg dc-msg-bot">
        <p class="dc-msg-legal">Triagem analítica fundamentada em precedentes públicos do TJSP para fins didáticos e informativos. Não constitui consultoria jurídica nem contratação advocatícia. Havendo demanda contenciosa, consulte um advogado especializado.</p>
        <p class="dc-msg-prompt">Selecione a matéria para mapear os precedentes e o lastro probatório no TJSP:</p>
      </div>

      <!-- Grade de Botões Iniciais das 14 Verticais -->
      <div class="dc-chips" id="dcChips">
        {TEMAS.map((t) => (
          <button type="button" class="dc-chip" data-slug={t.slug} data-nome={t.nome}>
            <Icon name={t.icone} size={15} />
            <span>{t.curto}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Rodapé em Conformidade Rigorosa com a OAB -->
    <div class="dc-footer">
      <small>Pesquisa estatística didática · Provimento CFOAB nº 205/2021. Procure um advogado especializado.</small>
    </div>
  </div>

  <!-- Botão Flutuante: Padrão DefendaMe em Teal com quinas de 6px, sem foto, centralizado abaixo do chat -->
  <button type="button" id="dcToggle" class="dc-launcher" aria-label="Dúvidas sobre o JEC?" aria-expanded="false">
    <div class="dc-launcher-icon">
      <Icon name="chat" size={17} stroke={2.2} />
      <span class="dc-status-dot" id="dcDot"></span>
    </div>
    <span class="dc-launcher-text">Dúvidas sobre o JEC?</span>
  </button>
</div>

<script type="application/json" id="dcFormsData" set:html={caseFormsJson} />

<script is:inline define:vars={{ endpoint, whatsNumber: '5511966016189' }}>
(function(){
  var root = document.getElementById('defendaChat');
  if (!root) return;

  var formsEl = document.getElementById('dcFormsData');
  var CASE_FORMS = formsEl ? JSON.parse(formsEl.textContent) : {};

  var toggleBtn = document.getElementById('dcToggle');
  var win = document.getElementById('dcWindow');
  var closeBtn = document.getElementById('dcClose');
  var resetBtn = document.getElementById('dcReset');
  var msgs = document.getElementById('dcMessages');
  var dot = document.getElementById('dcDot');
  var initialMessagesHtml = msgs ? msgs.innerHTML : '';
  var isFinished = false;

  // Controle de Horário Comercial e Feriados Nacionais
  var now = new Date();
  var day = now.getDay();
  var hour = now.getHours();
  var feriados = ['01-01', '04-21', '05-01', '09-07', '10-12', '11-02', '11-15', '11-20', '12-25'];
  var mmdd = ('0' + (now.getMonth() + 1)).slice(-2) + '-' + ('0' + now.getDate()).slice(-2);
  var isFeriado = feriados.indexOf(mmdd) !== -1;
  var isComercial = !isFeriado && (day >= 1 && day <= 5 && hour >= 9 && hour < 18);

  if (dot) {
    if (isComercial) dot.classList.add('online');
    else dot.classList.add('plantao');
  }

  // Timer de Retração Automática por Inatividade (35 segundos)
  var inactivityTimer = null;
  var INACTIVITY_DELAY = 35000;

  function resetInactivityTimer() {
    clearTimeout(inactivityTimer);
    if (!win.hidden) {
      inactivityTimer = setTimeout(function(){
        closeChat();
      }, INACTIVITY_DELAY);
    }
  }

  function openChat() {
    win.hidden = false;
    toggleBtn.setAttribute('aria-expanded', 'true');
    toggleBtn.classList.add('active');
    scrollBottom();
    resetInactivityTimer();
  }

  function resetChat() {
    isFinished = false;
    caso = {
      origem: 'Chat Online',
      tag: 'chat',
      categoria: '',
      slug: '',
      protocolo: ''
    };
    fieldsQueue = [];
    fieldIdx = 0;
    if (msgs) msgs.innerHTML = initialMessagesHtml;
    bindChipsClick();
    scrollBottom();
    resetInactivityTimer();
  }

  function closeChat() {
    win.hidden = true;
    toggleBtn.setAttribute('aria-expanded', 'false');
    toggleBtn.classList.remove('active');
    clearTimeout(inactivityTimer);
    if (isFinished) {
      resetChat();
    }
  }

  toggleBtn.addEventListener('click', function(e){
    e.stopPropagation();
    if (win.hidden) openChat(); else closeChat();
  });

  closeBtn.addEventListener('click', function(e){
    e.stopPropagation();
    closeChat();
  });

  if (resetBtn) {
    resetBtn.addEventListener('click', function(e){
      e.stopPropagation();
      resetChat();
    });
  }

  // Impede que cliques dentro da janela fechem o chat
  win.addEventListener('click', function(e){
    e.stopPropagation();
    resetInactivityTimer();
  });

  // Fecha automaticamente se clicar fora do componente
  document.addEventListener('click', function(e){
    if (win.hidden) return;
    var path = e.composedPath ? e.composedPath() : [];
    for (var i = 0; i < path.length; i++) {
      if (path[i] === win || path[i] === toggleBtn || path[i] === root) {
        return;
      }
    }
    if (win.contains(e.target) || toggleBtn.contains(e.target) || root.contains(e.target)) {
      return;
    }
    closeChat();
  });

  // Fecha ao teclar Escape
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape' && !win.hidden) {
      closeChat();
    }
  });

  // Atividades do usuário dentro da janela do chat resetam o timer de inatividade
  win.addEventListener('mousemove', resetInactivityTimer);
  win.addEventListener('keydown', resetInactivityTimer);
  win.addEventListener('scroll', resetInactivityTimer);

  function scrollBottom() {
    setTimeout(function(){
      msgs.scrollTop = msgs.scrollHeight;
    }, 40);
  }

  function addBotMsg(html) {
    var div = document.createElement('div');
    div.className = 'dc-msg dc-msg-bot';
    div.innerHTML = html;
    msgs.appendChild(div);
    scrollBottom();
    resetInactivityTimer();
  }

  function addUserMsg(text) {
    var div = document.createElement('div');
    div.className = 'dc-msg dc-msg-user';
    div.textContent = text;
    msgs.appendChild(div);
    scrollBottom();
    resetInactivityTimer();
  }

  // Remove qualquer parênteses de rótulos
  function limpaTexto(str) {
    if (!str) return '';
    return str.replace(/\s*\([^)]*\)/g, '').trim();
  }

  // Ícones SVG para garantir harmonia em todas as telas subsequentes
  var ICONS_SVG = {
    bank: '<path d="M3 21h18"/><path d="M5 21V10M19 21V10M9 21v-11M15 21V10"/><path d="m2 10 10-6 10 6"/>',
