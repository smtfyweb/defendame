---
/**
 * Assistente Conversacional de Pesquisa Jurimétrica do DefendaMe.
 * Conexão direta com Google Sheets + Gemini AI + WhatsApp 1-Clique.
 * Em estrita conformidade com o Provimento CFOAB nº 205/2021:
 * Caráter puramente didático e informativo de jurimetria sobre dados públicos do TJSP.
 * Não constitui serviço advocatício, não substitui consulta e não gera contratação.
 * 
 * Paleta de Cores Oficial do Projeto (Tokens DataNova):
 * - Fundo da janela e cabeçalho: var(--surface) (#ffffff)
 * - Área de conversa: var(--bg) (#f6fbfa)
 * - Botão launcher: var(--teal) (#12857e) com quinas de 6px
 * - Logo DefendaMe 100% visível e centralizada no cabeçalho
 * - Botões e chips em var(--surface) com hover em var(--teal-pale) (#e6f4f2)
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE } from '../data/site';
import { TEMAS } from '../data/temas';
import { CASE_FORMS } from '../data/caseForms';

const endpoint = SITE.formEndpoint;
const caseFormsJson = JSON.stringify(CASE_FORMS);
---

<div id="defendaChat" class="dc-root" aria-live="polite">
  <!-- Botão Flutuante: Padrão DefendaMe em Teal com quinas de 6px, sem foto -->
  <button type="button" id="dcToggle" class="dc-launcher" aria-label="Dúvidas sobre o JEC?" aria-expanded="false">
    <div class="dc-launcher-icon">
      <Icon name="chat" size={17} stroke={2.2} />
      <span class="dc-status-dot" id="dcDot"></span>
    </div>
    <span class="dc-launcher-text">Dúvidas sobre o JEC?</span>
  </button>

  <!-- Janela do Chat -->
  <div id="dcWindow" class="dc-window" hidden role="dialog" aria-modal="true" aria-labelledby="dcHeaderTitle">
    <!-- Cabeçalho com Logo DefendaMe Centralizada em Fundo Surface Oficial -->
    <div class="dc-header">
      <div class="dc-header-spacer"></div>
      <div class="dc-header-center">
        <Logo href="javascript:void(0)" class="dc-header-logo" />
      </div>
      <button type="button" id="dcClose" class="dc-close-btn" aria-label="Fechar pesquisa">
        <Icon name="x" size={18} stroke={2.2} />
      </button>
    </div>

    <!-- Barra de Aviso Ético e Didático em Teal Claro -->
    <div class="dc-notice" id="dcNoticeBar">
      <div class="dc-notice-head">
        <Icon name="shield" size={13} stroke={2.2} />
        <span class="dc-notice-title">Pesquisa Didática · Sem Vínculo Advocatício</span>
      </div>
      <p class="dc-notice-body" id="dcNoticeText">
        Este serviço trata-se exclusivamente de pesquisa jurimétrica sobre dados do TJSP para fins didáticos e informativos. Não se trata de consultoria jurídica nem contratação de advocacia e não substitui a análise de um advogado. Havendo demanda contenciosa, procure um advogado especializado.
      </p>
    </div>

    <!-- Área de Mensagens da Conversa -->
    <div class="dc-messages" id="dcMessages">
      <!-- Mensagens Iniciais do Bot -->
      <div class="dc-msg dc-msg-bot">
        <p>Olá! Sou o assistente de pesquisa jurimétrica do DefendaMe.</p>
      </div>
      <div class="dc-msg dc-msg-bot">
        <p>Apresentamos dados e estatísticas reais do TJSP para fins exclusivamente didáticos e informativos. Esta triagem não constitui serviços advocatícios, não substitui consulta individual e não gera contratação. Para assessoria ou processo, procure um advogado especializado. Qual tema você deseja pesquisar nos precedentes do TJSP?</p>
      </div>

      <!-- Grade de Botões Iniciais das 14 Verticais -->
      <div class="dc-chips" id="dcChips">
        {TEMAS.map((t) => (
          <button type="button" class="dc-chip" data-slug={t.slug} data-nome={t.nome}>
            <Icon name={t.icone} size={15} />
            <span>{t.curto}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Rodapé em Conformidade Rigorosa com a OAB -->
    <div class="dc-footer">
      <small>Pesquisa estatística didática · Provimento CFOAB nº 205/2021. Procure um advogado especializado.</small>
    </div>
  </div>
</div>

<script type="application/json" id="dcFormsData" set:html={caseFormsJson} />

<script is:inline define:vars={{ endpoint, whatsNumber: '5511966016189' }}>
(function(){
  var root = document.getElementById('defendaChat');
  if (!root) return;

  var formsEl = document.getElementById('dcFormsData');
  var CASE_FORMS = formsEl ? JSON.parse(formsEl.textContent) : {};

  var toggleBtn = document.getElementById('dcToggle');
  var win = document.getElementById('dcWindow');
  var closeBtn = document.getElementById('dcClose');
  var msgs = document.getElementById('dcMessages');
  var chipsWrap = document.getElementById('dcChips');
  var dot = document.getElementById('dcDot');
  var noticeBar = document.getElementById('dcNoticeBar');

  // Checagem de Horário Comercial
  var now = new Date();
  var day = now.getDay();
  var hour = now.getHours();
  var isComercial = (day >= 1 && day <= 5 && hour >= 9 && hour < 18);

  if (isComercial) {
    if (dot) dot.classList.add('online');
    if (noticeBar) noticeBar.classList.add('is-open');
  } else {
    if (dot) dot.classList.add('plantao');
    if (noticeBar) noticeBar.classList.add('is-plantao');
  }

  function openChat() {
    win.hidden = false;
    toggleBtn.setAttribute('aria-expanded', 'true');
    toggleBtn.classList.add('active');
    scrollBottom();
  }

  function closeChat() {
    win.hidden = true;
    toggleBtn.setAttribute('aria-expanded', 'false');
    toggleBtn.classList.remove('active');
  }

  toggleBtn.addEventListener('click', function(){
    if (win.hidden) openChat(); else closeChat();
  });
  closeBtn.addEventListener('click', closeChat);

  function scrollBottom() {
    setTimeout(function(){
      msgs.scrollTop = msgs.scrollHeight;
    }, 40);
  }

  function addBotMsg(html) {
    var div = document.createElement('div');
    div.className = 'dc-msg dc-msg-bot';
    div.innerHTML = html;
    msgs.appendChild(div);
    scrollBottom();
  }

  function addUserMsg(text) {
    var div = document.createElement('div');
    div.className = 'dc-msg dc-msg-user';
    div.textContent = text;
    msgs.appendChild(div);
    scrollBottom();
  }

  // Remove qualquer parênteses de rótulos
  function limpaTexto(str) {
    if (!str) return '';
    return str.replace(/\s*\([^)]*\)/g, '').trim();
  }

  // Ícones SVG para garantir harmonia em todas as telas subsequentes
  var ICONS_SVG = {
    bank: '<path d="M3 21h18"/><path d="M5 21V10M19 21V10M9 21v-11M15 21V10"/><path d="m2 10 10-6 10 6"/>',
    plane: '<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>',
    zap: '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>',
    phone: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
    alert: '<path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>',
    shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
    receipt: '<path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 17.5v-11"/>',
    pin: '<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>',
    clock: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
    check: '<polyline points="20 6 9 17 4 12"/>',
    x: '<path d="M18 6 6 18M6 6l12 12"/>',
    pencil: '<path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>',
    doc: '<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><path d="M16 13H8M16 17H8M10 9H8"/>',
    card: '<rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/>',
    arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
    send: '<path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/>',
    whatsapp: '<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>'
  };

  function makeSvg(name, sz) {
    var s = sz || 14;
    var inner = ICONS_SVG[name] || ICONS_SVG.check;
    var fillAttr = (name === 'whatsapp') ? 'fill="currentColor" stroke="none"' : 'fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"';
    return '<svg width="' + s + '" height="' + s + '" viewBox="0 0 24 24" ' + fillAttr + ' class="dc-chip-ic">' + inner + '</svg>';
  }

  // Resolve automaticamente o melhor ícone para cada opção de botão
  function resolveOptionIcon(label, fieldId) {
    var t = (label || '').toLowerCase();
    var f = (fieldId || '').toLowerCase();

    if (f === 'cidade' || f === 'cidade_cartorio' || t.indexOf('capital') !== -1 || t.indexOf('região') !== -1 || t.indexOf('comarca') !== -1 || t.indexOf('interior') !== -1 || t.indexOf('abc') !== -1 || t.indexOf('santista') !== -1) return 'pin';
    if (f === 'valor' || f === 'renda' || f === 'parcelas' || f === 'gastos' || t.indexOf('r$') !== -1 || t.indexOf('reais') !== -1 || t.indexOf('custo') !== -1 || t.indexOf('gasto') !== -1 || t.indexOf('prejuízo') !== -1) return 'receipt';
    if (f === 'data' || f === 'desde' || t.indexOf('hoje') !== -1 || t.indexOf('semana') !== -1 || t.indexOf('mês') !== -1 || t.indexOf('dias') !== -1 || t.indexOf('horas') !== -1) return 'clock';
    if (t.indexOf('sim') === 0 || t.indexOf('já tenho') !== -1 || t.indexOf('positivo') !== -1 || t.indexOf('concordo') !== -1) return 'check';
    if (t.indexOf('não') === 0 || t.indexOf('nunca') !== -1 || t.indexOf('recusou') !== -1 || t.indexOf('sem acréscimo') !== -1) return 'x';
    if (t.indexOf('outro') !== -1 || t.indexOf('digitar') !== -1 || t.indexOf('escrever') !== -1 || t.indexOf('informar') !== -1 || t.indexOf('acrescentar') !== -1) return 'pencil';
    if (f === 'banco' || t.indexOf('banco') !== -1 || t.indexOf('nubank') !== -1 || t.indexOf('itaú') !== -1 || t.indexOf('bradesco') !== -1 || t.indexOf('santander') !== -1 || t.indexOf('caixa') !== -1 || t.indexOf('inter') !== -1 || t.indexOf('c6') !== -1 || t.indexOf('pan') !== -1 || t.indexOf('bmg') !== -1 || t.indexOf('safra') !== -1) return 'bank';
    if (f === 'cia' || t.indexOf('latam') !== -1 || t.indexOf('gol') !== -1 || t.indexOf('azul') !== -1 || t.indexOf('passaredo') !== -1 || t.indexOf('voo') !== -1 || t.indexOf('aéreo') !== -1 || t.indexOf('atraso') !== -1 || t.indexOf('cancelamento') !== -1 || t.indexOf('overbooking') !== -1 || t.indexOf('conexão') !== -1) return 'plane';
    if (t.indexOf('enel') !== -1 || t.indexOf('cpfl') !== -1 || t.indexOf('energia') !== -1 || t.indexOf('luz') !== -1 || t.indexOf('sabesp') !== -1 || t.indexOf('comgás') !== -1) return 'zap';
    if (f === 'operadora' || t.indexOf('claro') !== -1 || t.indexOf('vivo') !== -1 || t.indexOf('tim') !== -1 || t.indexOf('telefonia') !== -1 || t.indexOf('ligação') !== -1 || t.indexOf('linha') !== -1) return 'phone';
    if (t.indexOf('cartão') !== -1 || t.indexOf('fatura') !== -1 || t.indexOf('anuidade') !== -1 || t.indexOf('rmc') !== -1 || t.indexOf('rcc') !== -1) return 'card';
    if (f === 'orgao' || f === 'bo' || t.indexOf('boletim') !== -1 || t.indexOf('documento') !== -1 || t.indexOf('contrato') !== -1 || t.indexOf('serasa') !== -1 || t.indexOf('spc') !== -1 || t.indexOf('boa vista') !== -1) return 'doc';
    if (t.indexOf('golpe') !== -1 || t.indexOf('fraude') !== -1 || t.indexOf('falso') !== -1 || t.indexOf('invasão') !== -1 || t.indexOf('alerta') !== -1 || t.indexOf('clonado') !== -1) return 'alert';
    if (t.indexOf('med') !== -1 || t.indexOf('segurança') !== -1 || t.indexOf('bloqueio') !== -1) return 'shield';
    return 'check';
  }

  // Sugestões de Botões Harmoniosos para campos de texto frequentes
  var BANCOS_SUGERIDOS = ['Nubank', 'Itaú', 'Bradesco', 'Santander', 'Banco C6', 'Caixa', 'Banco Inter'];
  var CIAS_SUGERIDAS = ['LATAM', 'GOL', 'Azul', 'Passaredo'];
  var CONCESSOES_SUGERIDAS = ['Enel SP', 'CPFL', 'Sabesp', 'Comgás', 'Claro', 'Vivo', 'TIM'];
  var CIDADES_SUGERIDAS = ['São Paulo Capital', 'Barueri ou Alphaville', 'Osasco e Região', 'Guarulhos', 'Campinas e Interior', 'Grande ABC', 'Baixada Santista'];
  var VALORES_SUGERIDOS = ['Até R$ 1.000', 'De R$ 1.000 a R$ 5.000', 'De R$ 5.000 a R$ 15.000', 'Acima de R$ 15.000'];
  var DATAS_SUGERIDAS = ['Hoje ou últimas 24 horas', 'Nos últimos 7 dias', 'Neste mês', 'Há mais de 30 dias'];

  // Estado da Sessão
  var caso = {
    origem: 'Chat Online',
    categoria: '',
    slug: '',
    protocolo: ''
  };

  var fieldsQueue = [];
  var fieldIdx = 0;

  // Etapa 1: Usuário escolhe a Vertical
  if (chipsWrap) {
    chipsWrap.addEventListener('click', function(e){
      var btn = e.target.closest('.dc-chip');
      if (!btn) return;
      var slug = btn.dataset.slug;
      var nome = btn.dataset.nome;
      caso.categoria = nome;
      caso.slug = slug;
      chipsWrap.remove();
      addUserMsg(nome);

      var formData = CASE_FORMS[slug];
      fieldsQueue = formData ? formData.campos : [];
      fieldIdx = 0;

      setTimeout(function(){
        addBotMsg('<p>Entendido. Vamos verificar os critérios do TJSP e o lastro probatório para <b>' + nome + '</b>.</p>');
        setTimeout(processNextField, 350);
      }, 350);
    });
  }

  // Processamento Dinâmico dos Campos com Botões e Ícones
  function processNextField() {
    if (fieldIdx < fieldsQueue.length) {
      var f = fieldsQueue[fieldIdx];
      renderFieldStep(f);
    } else {
      askCity();
    }
  }

  function renderFieldStep(f) {
    var rotuloLimpo = limpaTexto(f.rotulo);

    // Caso 1: Campo com opções predefinidas (Select)
    if (f.tipo === 'select' && f.opcoes && f.opcoes.length) {
      addBotMsg('<p>Selecione uma opção sobre <b>' + rotuloLimpo + '</b>:</p>');
      renderButtonOptions(f.opcoes, function(selectedVal){
        caso[f.id] = selectedVal;
        addUserMsg(selectedVal);
        fieldIdx++;
        setTimeout(processNextField, 350);
      }, '✏️ Outro detalhe', f.id);
      return;
    }

    // Caso 2: Pergunta sobre Banco ou Empresa Envolvida
    if (f.id === 'banco' || f.id === 'empresa' || f.id === 'operadora' || f.id === 'loja' || f.id === 'cia') {
      var tipoNome = (f.id === 'banco') ? 'o banco ou instituição financeira' : (f.id === 'cia' ? 'a companhia aérea' : 'a empresa');
      addBotMsg('<p>Qual é <b>' + tipoNome + '</b> envolvida no caso?</p>');
      var sugestoes = BANCOS_SUGERIDOS;
      if (caso.slug === 'transporte-aereo' || caso.slug === 'bagagem' || f.id === 'cia') sugestoes = CIAS_SUGERIDAS;
      else if (caso.slug === 'energia-eletrica' || caso.slug === 'telefonia') sugestoes = CONCESSOES_SUGERIDAS;

      renderButtonOptions(sugestoes, function(selectedVal){
        caso[f.id] = selectedVal;
        addUserMsg(selectedVal);
        fieldIdx++;
        setTimeout(processNextField, 350);
      }, '✏️ Digitar outro nome', f.id);
      return;
    }

    // Caso 3: Pergunta sobre Valores Envolvidos
    if (f.tipo === 'money' || f.id === 'valor') {
      addBotMsg('<p>Qual é a <b>faixa de valor</b> envolvida?</p>');
      renderButtonOptions(VALORES_SUGERIDOS, function(selectedVal){
        caso[f.id] = selectedVal;
        addUserMsg(selectedVal);
        fieldIdx++;
        setTimeout(processNextField, 350);
      }, '✏️ Informar valor exato', 'valor');
      return;
    }

    // Caso 4: Campos de Data com opções imediatas de botões
    if (f.tipo === 'date' || f.tipo === 'month') {
      addBotMsg('<p>Quando ocorreu o fato? Selecione o <b>período aproximado</b>:</p>');
      renderButtonOptions(DATAS_SUGERIDAS, function(selectedData){
        caso[f.id] = selectedData;
        addUserMsg(selectedData);
        fieldIdx++;
        setTimeout(processNextField, 350);
      }, '✏️ Informar data exata', 'data');
      return;
    }

    // Caso Geral: Texto simples
    addBotMsg('<p>Informe um detalhe sobre <b>' + rotuloLimpo + '</b>:</p>');
    renderHarmoniousInput(f.id, rotuloLimpo, 'text', f.placeholder || 'Informe este detalhe...');
  }

  // Renderizador de Botões Harmoniosos com Ícones SVG
  function renderButtonOptions(opcoesList, onSelectCallback, textoBotaoCustom, currentFieldId) {
    var container = document.createElement('div');
    container.className = 'dc-chips dc-field-chips';

    opcoesList.forEach(function(item){
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'dc-chip';
      var icName = resolveOptionIcon(item, currentFieldId);
      btn.innerHTML = makeSvg(icName, 14) + '<span>' + limpaTexto(item) + '</span>';
      container.appendChild(btn);

      btn.addEventListener('click', function(){
        container.remove();
        onSelectCallback(item);
      });
    });

    if (textoBotaoCustom) {
      var btnCustom = document.createElement('button');
      btnCustom.type = 'button';
      btnCustom.className = 'dc-chip dc-chip-write';
      btnCustom.innerHTML = makeSvg('pencil', 14) + '<span>' + textoBotaoCustom + '</span>';
      container.appendChild(btnCustom);

      btnCustom.addEventListener('click', function(){
        container.remove();
        renderHarmoniousInput('custom_val', 'Detalhe', 'text', 'Digite aqui o detalhe desejado...', function(digitado){
          onSelectCallback(digitado);
        });
      });
    }

    msgs.appendChild(container);
    scrollBottom();
  }

  // Campo de Entrada Harmonioso com Botão Estilizado de 6px e Ícone
  function renderHarmoniousInput(fieldId, rotulo, inputType, placeholder, customCallback) {
    var box = document.createElement('div');
    box.className = 'dc-input-line';

    var inp = document.createElement('input');
    inp.type = inputType;
    inp.placeholder = placeholder;
    inp.className = 'dc-text-input';

    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'dc-chip dc-chip-submit';
    btn.innerHTML = '<span>Confirmar</span>' + makeSvg('arrow', 13);

    box.appendChild(inp);
    box.appendChild(btn);
    msgs.appendChild(box);
    scrollBottom();
    inp.focus();

    function commit() {
      var val = inp.value.trim();
      if (!val) {
        alert('Por favor, informe este detalhe para continuarmos.');
        return;
      }
      box.remove();
      if (customCallback) {
        customCallback(val);
      } else {
        caso[fieldId] = val;
        addUserMsg(val);
        fieldIdx++;
        setTimeout(processNextField, 350);
      }
    }

    btn.addEventListener('click', commit);
    inp.addEventListener('keydown', function(e){ if (e.key === 'Enter') commit(); });
  }

  // Etapa: Cidade do Estado de SP com Botões de Localização
  function askCity() {
    addBotMsg('<p>Em qual comarca ou região do Estado de São Paulo você reside?</p>');
    renderButtonOptions(CIDADES_SUGERIDAS, function(cidadeEscolhida){
      caso.cidade = cidadeEscolhida;
      addUserMsg(cidadeEscolhida);
      setTimeout(askFreeDetails, 350);
    }, '✏️ Outra comarca paulista', 'cidade');
  }

  // Etapa: Detalhes Complementares com Botões Didáticos
  function askFreeDetails() {
    addBotMsg('<p>Deseja acrescentar algum detalhe específico com suas próprias palavras?</p>');

    var chips = document.createElement('div');
    chips.className = 'dc-chips dc-field-chips';

    var btnNao = document.createElement('button');
    btnNao.type = 'button';
    btnNao.className = 'dc-chip';
    btnNao.innerHTML = makeSvg('check', 14) + '<span>Não, as opções acima já cobrem meu caso</span>';

    var btnSim = document.createElement('button');
    btnSim.type = 'button';
    btnSim.className = 'dc-chip dc-chip-write';
    btnSim.innerHTML = makeSvg('pencil', 14) + '<span>✏️ Sim, quero acrescentar um breve texto</span>';

    chips.appendChild(btnNao);
    chips.appendChild(btnSim);
    msgs.appendChild(chips);
    scrollBottom();

    btnNao.addEventListener('click', function(){
      chips.remove();
      caso.descricao = 'Caso estruturado via triagem indutiva de perguntas objetivas.';
      addUserMsg('Sem acréscimos adicionais');
      setTimeout(askContact, 350);
    });

    btnSim.addEventListener('click', function(){
      chips.remove();
      var box = document.createElement('div');
      box.className = 'dc-input-line dc-input-line-col';
      box.innerHTML = 
        '<textarea id="dcDescText" rows="3" class="dc-textarea" placeholder="Descreva sucintamente outros pontos relevantes..."></textarea>' +
        '<button type="button" id="dcSaveDesc" class="dc-chip dc-chip-submit" style="align-self:flex-end; margin-top:6px;"><span>Avançar</span>' + makeSvg('arrow', 13) + '</button>';
      msgs.appendChild(box);
      scrollBottom();
      document.getElementById('dcDescText').focus();

      document.getElementById('dcSaveDesc').addEventListener('click', function(){
        var val = document.getElementById('dcDescText').value.trim();
        caso.descricao = val || 'Relato estruturado via triagem indutiva.';
        box.remove();
        if (val) addUserMsg(val);
        setTimeout(askContact, 350);
      });
    });
  }

  // Etapa Final: Identificação para Retorno com Aviso Didático
  function askContact() {
    addBotMsg('<p>Excelente. Para onde devemos enviar o relatório didático de jurimetria do TJSP e a relação de provas? Informe seus dados para retorno:</p>');

    var formBox = document.createElement('div');
    formBox.className = 'dc-input-line dc-input-line-col dc-card-contact';
    formBox.innerHTML = 
      '<div class="dc-legal-badge">' +
        makeSvg('shield', 13) +
        '<span>Pesquisa Didática · Sem Vínculo Advocatício</span>' +
      '</div>' +
      '<label class="dc-field"><span>Seu nome completo <i>*</i></span><input type="text" id="dcNome" class="dc-text-input" placeholder="Seu nome" required /></label>' +
      '<label class="dc-field"><span>WhatsApp com DDD <i>*</i></span><input type="tel" id="dcWhats" class="dc-text-input" placeholder="DDD + número" required /></label>' +
      '<label class="dc-field"><span>E-mail opcional</span><input type="email" id="dcEmail" class="dc-text-input" placeholder="seu@email.com" /></label>' +
      '<label class="dc-ok"><input type="checkbox" id="dcLgpd" checked /><span>Declaro ciência de que esta pesquisa jurimétrica é puramente didática e informativa, não substituindo consulta com advogado nem constituindo contratação de serviços de advocacia.</span></label>' +
      '<button type="button" id="dcSubmit" class="dc-send-btn">' +
        makeSvg('send', 15) +
        '<span>Receber Pesquisa Jurimétrica Didática</span>' +
      '</button>';
    msgs.appendChild(formBox);
    scrollBottom();

    document.getElementById('dcSubmit').addEventListener('click', function(){
      var nome = document.getElementById('dcNome').value.trim();
      var whats = document.getElementById('dcWhats').value.trim();
      var email = document.getElementById('dcEmail').value.trim();
      var lgpd = document.getElementById('dcLgpd').checked;

      if (!nome) { alert('Informe seu nome completo.'); return; }
      if (!whats || whats.replace(/\D/g, '').length < 10) { alert('Informe um WhatsApp válido com DDD.'); return; }
      if (!lgpd) { alert('Você precisa concordar com os termos informativos.'); return; }

      var proto = 'DM-' + new Date().toISOString().slice(2,10).replace(/-/g,'') + '-' + Math.random().toString(36).slice(2,6).toUpperCase();
      caso.nome = nome;
      caso.whatsapp = whats;
      caso.email = email;
      caso.protocolo = proto;
      caso.pagina = location.pathname;

      formBox.remove();
      addUserMsg(nome + ' · ' + whats);

      addBotMsg('<p>⏳ <i>Enviando relato para análise da jurimetria...</i></p>');

      this.disabled = true;

      fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(caso)
      })
      .then(function(){ finalizarSucesso(proto); })
      .catch(function(){ finalizarSucesso(proto); });
    });
  }

  function finalizarSucesso(proto) {
    var txtHorario = isComercial 
      ? 'Como estamos em <b>horário de expediente</b>, o diagnóstico jurimétrico didático e a relação probatória serão enviados para o seu WhatsApp em breve.'
      : 'Como você enviou fora do expediente comercial, o seu protocolo está registrado no <b>Plantão de Jurimetria</b> e o relatório didático será encaminhado no primeiro horário útil seguinte.';

    var msgWhats = 'Olá André Silva, acabei de registrar a pesquisa no portal DefendaMe sob o protocolo ' + proto + ' sobre ' + caso.categoria + ' e gostaria de receber o relatório didático de jurimetria do TJSP.';
    var linkWhats = 'https://api.whatsapp.com/send?phone=' + whatsNumber + '&text=' + encodeURIComponent(msgWhats);

    var html = 
      '<div class="dc-success">' +
        '<p>✅ <b>Pesquisa Jurimétrica Registrada!</b></p>' +
        '<p class="dc-proto-badge">Protocolo: <b>' + proto + '</b></p>' +
        '<p>' + txtHorario + '</p>' +
        '<p class="dc-notice-legal" style="margin-top:8px; font-size:11px; color:var(--fg-muted); line-height:1.35;">Lembramos que este relatório tem caráter didático e informativo, não configurando prestação de serviços advocatícios. Havendo necessidade de processo judicial, procure um advogado especializado.</p>' +
        '<div class="dc-done-actions">' +
          '<a href="' + linkWhats + '" target="_blank" rel="noopener" class="btn btn-whatsapp dc-wbtn">' +
            makeSvg('whatsapp', 16) +
            '<span>Receber no WhatsApp</span>' +
          '</a>' +
        '</div>' +
      '</div>';

    var lastMsg = msgs.querySelector('.dc-msg-bot:last-child');
    if (lastMsg && lastMsg.textContent.indexOf('Enviando relato') !== -1) {
      lastMsg.remove();
    }

    addBotMsg(html);
  }
})();
</script>

