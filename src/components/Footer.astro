---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { GRUPOS, temasDoGrupo, type Grupo } from '../data/temas';
import { SITE, DATASET } from '../data/site';
const grupos = Object.keys(GRUPOS) as Grupo[];
---
<footer class="footer" id="rodape">
  <div class="fmap">
    <div class="fbrand">
      <Logo />
      <p class="fdesc">Plataforma independente de jurimetria e inteligência jurídica dedicada a esclarecer os direitos do cidadão no Juizado Especial Cível através da análise empírica de decisões do TJSP. Conteúdo estritamente informativo e educativo, em plena conformidade com o Provimento CFOAB nº 205/2021.</p>
      <div class="fsocial" aria-label="Redes sociais do DefendaMe">
        <a href={SITE.instagram} target="_blank" rel="noopener noreferrer" title="Instagram" aria-label="DefendaMe no Instagram" class="fs-in"><Icon name="instagram" size={17} /></a>
        <a href={SITE.youtube} target="_blank" rel="noopener noreferrer" title="YouTube" aria-label="Canal DefendaMe no YouTube" class="fs-yt"><Icon name="youtube" size={17} /></a>
        <a href={SITE.whatsapp} target="_blank" rel="noopener noreferrer" title="WhatsApp" aria-label="Canal DefendaMe no WhatsApp" class="fs-wa"><Icon name="whatsapp" size={17} /></a>
        <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" title="LinkedIn" aria-label="DefendaMe no LinkedIn" class="fs-li"><Icon name="linkedin" size={17} /></a>
        <a href={SITE.twitter} target="_blank" rel="noopener noreferrer" title="X (Twitter)" aria-label="DefendaMe no X" class="fs-x"><Icon name="x-brand" size={17} /></a>
        <a href={SITE.facebook} target="_blank" rel="noopener noreferrer" title="Facebook" aria-label="DefendaMe no Facebook" class="fs-fb"><Icon name="facebook" size={17} /></a>
        <a href={SITE.substack} target="_blank" rel="noopener noreferrer" title="Substack" aria-label="DefendaMe no Substack" class="fs-ss"><Icon name="substack" size={17} /></a>
      </div>
    </div>
    {grupos.map((g) => (
      <div class="fcol"><div class="fcol-h">{GRUPOS[g]}</div>{temasDoGrupo(g).map((t) => <a href={`/${t.slug}/`}>{t.nome}</a>)}</div>
    ))}
    <div class="fcol"><div class="fcol-h">Institucional</div>
      <a href="/quem-somos/">Quem somos</a><a href="/autor/andre-l-silva/">André L. Silva</a><a href="/artigos/">Todos os artigos</a><a href="/faq/">Perguntas Frequentes (FAQ)</a><a href="/glossario/">Glossário do JEC</a><a href="/#verificar" data-open-case>Avaliar situação</a>
      <a href="/privacidade/">Política de privacidade</a><a href="/cookies/">Política de cookies</a>
      <button type="button" class="flink" data-cookie-prefs>Preferências de cookies</button>
    </div>
  </div>
  <div class="fbottom"><span>© {new Date().getFullYear()} DefendaMe · defendame.online</span><span><a href="/privacidade/">Privacidade</a> · <a href="/cookies/">Cookies</a> · Dados: TJSP · {DATASET.recorte}</span></div>
</footer>
